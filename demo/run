#!/usr/bin/env python3
"""Show the plugin in a throwaway Omarchy shell with a fictional home, and capture it.

    demo/run                               # preview.png, from the tokyo-night theme
    demo/run --theme catppuccin-latte --theme gruvbox --out /tmp/themes

Nothing of yours is touched or shown. A second shell starts with HOME set to a new
folder in XDG_RUNTIME_DIR. It reads only the committed files of Frestina's other
plugins from your plugins folder, with git archive, and nothing else of yours: none
of your config, other plugins or files. Those plugins are left out when they aren't
there. They read the fictional home, so they show no data of yours. The home also
holds a copy of this plugin whose bin/omaupdateimpact only prints one of the golden
documents in tests/fixtures/json, which are the command's own output on small
fictional trees.

Its bar sits at the top, under yours, with the icon just left of fleetlog's, between
Frestina's other plugins, as on a real bar. Its panels place themselves below one
bar, so they cover it: the image is its bar, taken before the panel opens, above the
panel, as one bar and its panel look. Left of the panel the demo bar shows through,
so the image starts at the panel's left edge. Omarchy's own services are off but for
the wallpaper, which shows the demo theme's own over yours. So your bar,
notifications and lock screen carry on.

It moves to an empty workspace while it captures, and goes back after. On any exit,
the second shell is stopped, your workspace comes back, and the folder is deleted.
Check every image before committing it.
"""

import argparse
import base64
import contextlib
import json
import os
import shlex
import shutil
import signal
import struct
import subprocess
import sys
import tempfile
import time
import types
import zlib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
GOLDEN = ROOT / "tests/fixtures/json"
EXIT_CODES = {"clear": 0, "noUpdate": 0, "attention": 1, "failed": 2, "incomplete": 3}
PREFIX = "omaupdateimpact-demo."
# In the fictional home: the fixture command touches it each time it runs.
CHECKED = ".checked"
# Logical pixels from the top right of the demo bar: the bar and the panel.
WIDTH, HEIGHT = 560, 800
# The right of the bar, as on the owner's: Frestina's public plugins, then Omarchy's.
NEIGHBOURS = ("io.github.frestina.cronward", "io.github.frestina.fleetlog", "io.github.frestina.fleetwatch")
RIGHT = (
    "io.github.frestina.cronward", "io.github.frestina.omaupdateimpact", "io.github.frestina.fleetlog",
    "io.github.frestina.fleetwatch", "omarchy.network", "omarchy.audio", "omarchy.power",
)


def manifest():
    return json.loads((ROOT / "manifest.json").read_text())


def run(*args, **kwargs):
    return subprocess.run(args, capture_output=True, text=True, check=True, timeout=30, **kwargs).stdout


def hypr(*args):
    return json.loads(run("hyprctl", "-j", *args))


def first_party_services(omarchy):
    """Omarchy's own plugins that run without a bar entry, which the demo shell turns off."""
    found = []
    for path in (omarchy / "shell/plugins").rglob("*manifest.json"):
        data = json.loads(path.read_text())
        kinds = data.get("kinds", [])
        # The demo theme's own wallpaper covers yours, so it stays on.
        keep = {"omarchy.bar", "omarchy.background"}
        if data.get("id") and data["id"] not in keep and (kinds != ["bar-widget"] or data.get("keepLoaded")):
            found.append(data["id"])
    return sorted(found)


def theme(home, omarchy, name):
    """Make the named theme current in the fictional home, as omarchy-theme-set would."""
    source = omarchy / "themes" / name
    if not (source / "colors.toml").is_file():
        sys.exit(f"demo: no theme {name} in {omarchy / 'themes'}")
    current = home / ".local/state/omarchy/current"
    shutil.rmtree(current, ignore_errors=True)
    (current / "next-theme").mkdir(parents=True)
    shutil.copy(source / "colors.toml", current / "next-theme/colors.toml")
    environment = dict(os.environ, HOME=str(home), OMARCHY_PATH=str(omarchy))
    subprocess.run(["omarchy-theme-set-templates"], env=environment, check=True, capture_output=True, timeout=60)
    (current / "next-theme").rename(current / "theme")
    backgrounds = sorted((source / "backgrounds").glob("*")) if (source / "backgrounds").is_dir() else []
    if backgrounds:
        (current / "background").symlink_to(backgrounds[0])
    return current / "theme"


def neighbours(plugins):
    """Copies Frestina's other plugins from the commits in your plugins folder. Returns their ids."""
    yours = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "omarchy/plugins"
    found = []
    for plugin_id in NEIGHBOURS:
        source = (yours / plugin_id).resolve()
        archive = subprocess.run(
            ["git", "-C", str(source), "archive", "HEAD"], capture_output=True, check=False, timeout=30
        )
        if archive.returncode:
            print(f"demo: {plugin_id} isn't a git checkout in {yours}, so it was left out", file=sys.stderr)
            continue
        (plugins / plugin_id).mkdir(parents=True)
        subprocess.run(["tar", "-x", "-C", str(plugins / plugin_id)], input=archive.stdout, check=True, timeout=30)
        found.append(plugin_id)
    return found


def fictional_home(home, omarchy, document):
    """The fictional home: a shell.json with the widget, and the plugin with a fixture command."""
    plugin_id = manifest()["id"]
    config = home / ".config/omarchy"
    config.mkdir(parents=True)
    present = {plugin_id, *neighbours(config / "plugins")}
    right = [{"id": entry} for entry in RIGHT if entry in present or entry.startswith("omarchy.")]
    shell = {
        "version": 1,
        "bar": {
            "position": "top",
            "transparent": False,
            "layout": {"left": [], "center": [{"id": "omarchy.clock"}], "right": right},
        },
        "plugins": [],
        "disabledPlugins": first_party_services(omarchy),
    }
    (config / "shell.json").write_text(json.dumps(shell, indent=2) + "\n")

    plugin = config / "plugins" / plugin_id
    (plugin / "bin").mkdir(parents=True)
    shutil.copy(ROOT / "manifest.json", plugin)
    shutil.copytree(ROOT / "plugin", plugin / "plugin")
    (plugin / "bin/document.json").write_text(json.dumps(document, indent=2) + "\n")
    code = EXIT_CODES[document["result"]]
    # The mark is outside the plugin's folder, which the shell would reload on a change.
    mark = shlex.quote(str(home / CHECKED))
    fixture = plugin / "bin/omaupdateimpact"
    fixture.write_text(f'#!/bin/sh\n# A fixture: one document.\ncat "$(dirname "$0")/document.json"\ntouch {mark}\nexit {code}\n')
    fixture.chmod(0o755)


def demo_bar(pid, monitor, seconds=10):
    """Where the demo bar sits on the monitor, below your own, and how high it is."""
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        for level in hypr("layers").get(monitor["name"], {}).get("levels", {}).values():
            for layer in level:
                if layer["pid"] == pid and layer["namespace"] == "omarchy-bar":
                    return layer["y"] - monitor["y"], layer["h"]
        time.sleep(0.25)
    sys.exit(f"demo: the demo shell's bar didn't show within {seconds} seconds")


def capture(x, y, w, h):
    """The region's pixels from grim, as width, height and RGB rows."""
    data = subprocess.run(
        ["grim", "-t", "ppm", "-g", f"{x:.0f},{y:.0f} {w:.0f}x{h:.0f}", "-"], capture_output=True, check=True, timeout=30
    ).stdout
    magic, width, height, depth, pixels = data.split(maxsplit=4)
    if magic != b"P6" or depth != b"255":
        sys.exit("demo: grim's PPM wasn't 8-bit RGB")
    width, height = int(width), int(height)
    return width, [pixels[row * width * 3:(row + 1) * width * 3] for row in range(height)]


def panel_left(strip, panel):
    """The first pixel column where the panel covers the demo bar, which strip shows without it."""
    for column in range(0, len(strip[0]), 3):
        if any(s[column:column + 3] != p[column:column + 3] for s, p in zip(strip, panel)):
            return column
    sys.exit("demo: the panel didn't open")


def write_png(path, width, rows):
    def chunk(kind, body):
        return struct.pack(">I", len(body)) + kind + body + struct.pack(">I", zlib.crc32(kind + body))

    header = struct.pack(">IIBBBBB", width, len(rows), 8, 2, 0, 0, 0)
    image = zlib.compress(b"".join(b"\0" + row for row in rows), 9)
    path.write_bytes(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", header) + chunk(b"IDAT", image) + chunk(b"IEND", b""))


def go_to(workspace):
    """Hyprland 0.56 takes Lua; older ones the plain dispatcher."""
    lua = f'hl.dsp.focus({{ workspace = "{workspace}" }})'
    if subprocess.run(["hyprctl", "dispatch", lua], capture_output=True, check=False).returncode:
        run("hyprctl", "dispatch", "workspace", str(workspace))


def ipc(pid, *args):
    return run("qs", "ipc", "--pid", str(pid), *args)


def wait_for(pid, target, seconds=30):
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        try:
            if f"target {target}" in ipc(pid, "show"):
                return
        except subprocess.CalledProcessError:
            pass
        time.sleep(0.25)
    sys.exit(f"demo: the demo shell didn't offer {target} within {seconds} seconds")


def require(*commands):
    for command in commands:
        if not shutil.which(command):
            sys.exit(f"demo: {command} isn't installed")


def apply_theme(pid, current):
    payload = [base64.b64encode((current / file).read_bytes()).decode() for file in ("colors.toml", "shell.toml")]
    ipc(pid, "call", "shell", "applyTheme", *payload)


def check(demo, seconds=30):
    """Check again, and wait until the fixture has answered and the bar shows it."""
    mark = demo.home / CHECKED
    mark.unlink(missing_ok=True)
    ipc(demo.shell.pid, "call", manifest()["id"], "check")
    deadline = time.monotonic() + seconds
    while not mark.exists():
        if time.monotonic() > deadline:
            sys.exit(f"demo: the plugin didn't check within {seconds} seconds")
        time.sleep(0.1)
    time.sleep(1.0)


@contextlib.contextmanager
def session(document, theme_name):
    """A second shell on a fictional home whose plugin prints document, on an empty workspace.

    Whatever happens, the shell is stopped, your workspace comes back, and the folder is
    deleted. Yields the folder, the home, Omarchy's tree, the shell, its environment and
    the current theme's folder.
    """
    omarchy = Path(os.environ.get("OMARCHY_PATH") or "/usr/share/omarchy")
    runtime = Path(os.environ["XDG_RUNTIME_DIR"])
    stale = sorted(runtime.glob(PREFIX + "*"))
    if stale:
        sys.exit(f"demo: an earlier run left {stale[0]}. Stop any quickshell started from it, then delete it.")
    state = Path(tempfile.mkdtemp(prefix=PREFIX, dir=runtime))
    home = state / "home"
    shell = None
    workspace = hypr("activeworkspace")["id"]
    try:
        fictional_home(home, omarchy, document)
        current = theme(home, omarchy, theme_name)
        used = {w["id"] for w in hypr("workspaces")}
        empty = next(n for n in range(9, 100) if n not in used)
        go_to(empty)

        # Without PYTHONDONTWRITEBYTECODE, a neighbour's first run writes __pycache__
        # into its folder, and the shell reloads it over and over.
        environment = dict(
            os.environ, HOME=str(home), XDG_CONFIG_HOME=str(home / ".config"),
            XDG_STATE_HOME=str(home / ".local/state"), XDG_CACHE_HOME=str(home / ".cache"),
            XDG_DATA_HOME=str(home / ".local/share"), QS_DISABLE_FILE_WATCHER="1", QS_NO_RELOAD_POPUP="1",
            PYTHONDONTWRITEBYTECODE="1",
        )
        log = (state / "shell.log").open("w")
        shell = subprocess.Popen(
            ["quickshell", "-p", str(omarchy / "shell")], env=environment, stdout=log, stderr=log,
            start_new_session=True,
        )
        wait_for(shell.pid, manifest()["id"])
        yield types.SimpleNamespace(
            state=state, home=home, omarchy=omarchy, shell=shell, environment=environment, theme=current,
        )
    except BaseException:
        for log_file in sorted(state.glob("*.log")):
            print(f"demo: {log_file.name} ends:", *log_file.read_text().splitlines()[-40:], sep="\n", file=sys.stderr)
        raise
    finally:
        if shell:
            os.killpg(shell.pid, signal.SIGTERM)
            try:
                shell.wait(timeout=10)
            except subprocess.TimeoutExpired:
                os.killpg(shell.pid, signal.SIGKILL)
                shell.wait()
        try:
            go_to(workspace)
            print(f"demo: back on workspace {workspace}")
        except subprocess.CalledProcessError:
            print(f"demo: couldn't go back to workspace {workspace}", file=sys.stderr)
        if shell is None or shell.poll() is not None:
            shutil.rmtree(state)
        else:
            print(f"demo: the demo shell is still running; {state} was kept", file=sys.stderr)


def stop_on_signals():
    """SIGTERM and SIGHUP end the run as an error does, so everything is still cleaned up."""
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(1))
    signal.signal(signal.SIGHUP, lambda *_: sys.exit(1))


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--theme", action="append", help="a theme in $OMARCHY_PATH/themes (repeatable)")
    parser.add_argument("--result", default="report", help="a golden document in tests/fixtures/json")
    parser.add_argument("--out", type=Path, help="a folder for one PNG per theme, in place of preview.png")
    args = parser.parse_args()
    themes = args.theme or ["tokyo-night"]

    require("quickshell", "qs", "grim", "hyprctl", "omarchy-theme-set-templates")
    if not (GOLDEN / f"{args.result}.json").is_file():
        sys.exit(f"demo: no golden document {args.result}")
    document = json.loads((GOLDEN / f"{args.result}.json").read_text())

    with session(document, themes[0]) as demo:
        plugin_id = manifest()["id"]
        monitor = next(m for m in hypr("monitors") if m["focused"])
        width, height = monitor["width"] / monitor["scale"], monitor["height"] / monitor["scale"]
        top, bar = demo_bar(demo.shell.pid, monitor)
        w, h = min(WIDTH, width), min(HEIGHT, height - bar)
        x, y = monitor["x"] + width - w, monitor["y"]

        for index, name in enumerate(themes):
            current = theme(demo.home, demo.omarchy, name) if index else demo.theme
            apply_theme(demo.shell.pid, current)
            check(demo)
            pixels, strip = capture(x, y + top, w, bar)
            ipc(demo.shell.pid, "call", "shell", "summon", plugin_id, "{}")
            time.sleep(1.5)
            _, panel = capture(x, y + bar, w, h)
            target = args.out / f"{name}.png" if args.out else ROOT / "preview.png"
            target.parent.mkdir(parents=True, exist_ok=True)
            left = panel_left(strip, panel)
            write_png(target, pixels - left // 3, [row[left:] for row in strip + panel])
            ipc(demo.shell.pid, "call", "shell", "hide", plugin_id)
            time.sleep(0.5)
            print(f"demo: wrote {target}")

if __name__ == "__main__":
    stop_on_signals()
    main()
