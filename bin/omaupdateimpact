@dataclass
class Bind:
    description: str
    command: str
    source: str = ""
    keys: str = ""

    def same_action(self, other):
        if self.command == other.command:
            return True
        return bool(self.description) and self.description == other.description


@dataclass
class Computed:
    expression: str
    source: str


@dataclass
class Parsed:
    binds: dict = field(default_factory=dict)
    unbinds: dict = field(default_factory=dict)
    unread: list = field(default_factory=list)
    helpers: dict = field(default_factory=dict)


@dataclass
class Reason:
    """The change in the release notes that a finding comes from."""

    text: str
    reference: str
    evidence: str


@dataclass
class Finding:
    check: str
    level: str
    title: str
    evidence: list
    detail: str = ""
    fix: str = ""
    # An unknown that leaves the rest of its check standing.
    partial: bool = False
    reason: Reason | None = None
    # Seen by the user for this release, so it no longer counts. Only attention can be.
    reviewed: bool = False
    # What it is about, as (kind, name) pairs, for finding its reason. It isn't in the document.
    about: tuple = field(default=(), compare=False, repr=False)

    def text(self):
        return " ".join(part for part in (self.title, self.detail) if part)

    @property
    def id(self):
        """An id that stays the same while what the finding says does, in any release."""
        said = f"{self.check}\0{self.text()}".encode(errors="surrogateescape")
        return hashlib.sha256(said).hexdigest()[:ID_LENGTH]

    def data(self):
        """The finding as the --json document holds it. What it is about isn't copied, as a Word can't be."""
        data = dataclasses.asdict(dataclasses.replace(self, about=()))
        del data["about"]
        return {"id": self.id, **data}


class UnusableTree(Exception):
    """A tree that can't be compared: going on would report nothing to worry about."""


class RateLimited(OSError):
    """GitHub turned a request down because of its rate limit."""


class TokenRejected(OSError):
    """GitHub turned down the GITHUB_TOKEN it was given."""


class NoRelease(Exception):
    """A channel with no tagged release to follow."""


class ShellUnread(Exception):
    """A script this reader lost its place in."""


class NotReviewable(Exception):
    """An --ack that can't be recorded. Nothing is written."""


class LintFailed(Exception):
    """A lint that gave no answer, so it says nothing about the plugin."""


class Op(str):
    """A shell operator, as opposed to a quoted word that spells the same."""


class Word(str):
    """A shell word, and where in the text it starts."""

    def __new__(cls, text, at):
        word = super().__new__(cls, text)
        word.at = at
        return word


class Redirect(Word):
    """A file that a command's output goes to."""


def blank_comments(text):
    """Remove Lua comments, leaving strings alone."""
    out, i = [], 0
    while i < len(text):
        if text[i : i + 2] == "--":
            end = long_string_end(text, i + 2) or text.find("\n", i)
            if end < 0:
                break
            i = end
            continue
        end = quoted_end(text, i) or i + 1
        out.append(text[i:end])
        i = end
    return "".join(out)


def string_end(text, start):
    i = start + 1
    while i < len(text) and text[i] != text[start]:
        i += 2 if text[i] == "\\" else 1
    return min(i + 1, len(text))


def long_string_end(text, start):
    """Where the long string opening at start ends, or None if none opens there."""
    opened = LONG_STRING.match(text, start)
    if not opened:
        return None
    end = text.find(f"]{opened.group(1)}]", opened.end())
    return len(text) if end < 0 else end + len(opened.group(0))


def quoted_end(text, start):
    """Where the string of either kind opening at start ends, or None if none opens there."""
    return string_end(text, start) if text[start] in "\"'" else long_string_end(text, start)


def call_arguments(text, start):
    """Split the arguments of the call whose opening bracket is at start."""
    args, depth, current, i = [], 0, [], start
    while i < len(text):
        char = text[i]
        end = quoted_end(text, i)
        if end is not None:
            current.append(text[i:end])
            i = end
            continue
        if char in "([{":
            depth += 1
            if depth > 1:
                current.append(char)
        elif char in ")]}":
            depth -= 1
            if depth == 0:
                args.append("".join(current).strip())
                return args
            current.append(char)
        elif char == "," and depth == 1:
            args.append("".join(current).strip())
            current = []
        else:
            current.append(char)
        i += 1
    return args


def literal(arg):
    """The value of a plain Lua string, or None for anything computed."""
    opened = LONG_STRING.match(arg)
    if opened and long_string_end(arg, 0) == len(arg) and arg.endswith(f"]{opened.group(1)}]"):
        # Lua drops a newline straight after the opening bracket.
        return arg[opened.end() : -len(opened.group(0))].removeprefix("\n")
    if len(arg) >= 2 and arg[0] in "\"'" and string_end(arg, 0) == len(arg):
        return arg[1:-1].replace('\\"', '"').replace("\\'", "'")
    return None


def tidy(expression):
    """A Lua expression with its spacing evened out, so a reformat doesn't read as a change."""
    out, code, i = [], [], 0

    def flush():
        spaced = " ".join("".join(code).split())
        out.append(re.sub(r" ?([^\w ]) ?", r"\1", spaced).replace(",}", "}"))
        code.clear()

    while i < len(expression):
        end = quoted_end(expression, i)
        if end is None:
            code.append(expression[i])
            i += 1
        else:
            flush()
            out.append(expression[i:end])
            i = end
    flush()
    return "".join(out)


def normalize_keys(keys):
    parts = [part.strip().upper() for part in keys.split("+") if part.strip()]
    parts = [MODIFIER_SPELLINGS.get(part, part) for part in parts]
    mods = [mod for mod in MODIFIERS if mod in parts]
    rest = [part for part in parts if part not in MODIFIERS]
    return " + ".join(mods + rest)


def spelling(keys):
    """What hl.unbind matches: the keys as written, whatever their spaces and case, and not the chord."""
    return keys.replace(" ", "").lower()


def command_text(arg):
    value = literal(arg)
    return tidy(arg) if value is None else value


def unbind(parsed, keys, source):
    if keys == "all":
        parsed.binds.clear()
        return
    chord = normalize_keys(keys)
    parsed.unbinds.setdefault(chord, {})[spelling(keys)] = source
    left = [bind for bind in parsed.binds.get(chord, []) if spelling(bind.keys) != spelling(keys)]
    if left:
        parsed.binds[chord] = left
    else:
        parsed.binds.pop(chord, None)


def parse_lua(text, parsed, source=""):
    """Collect the bind and unbind calls in one Lua file."""
    text = blank_comments(text)
    names = "|".join(re.escape(name) for name in BIND_CALLS)
    for match in re.finditer(rf"(?<![\w.])({names})\s*\(", text):
        name = match.group(1)
        args = call_arguments(text, match.end() - 1)
        keys = literal(args[0]) if args else None
        if keys is None:
            expression = tidy(args[0]) if args else ""
            # Turning a key off isn't the same call as binding it, whatever the expression.
            parsed.unread.append(Computed(f"hl.unbind({expression})" if name == "hl.unbind" else expression, source))
            continue
        if name in ("hl.unbind", "o.rebind"):
            unbind(parsed, keys, source)
        if name == "hl.unbind":
            continue
        args += [""] * (5 - len(args))
        if name == "hl.bind":
            found = re.search(r"description\s*=\s*([\"'])(.*?)\1", args[2])
            pairs = [(found.group(2) if found else "", args[1])]
        elif name == "o.bind_hold":
            pairs = [(literal(args[1]) or "", args[2]), (literal(args[3]) or "", args[4])]
        else:
            pairs = [(literal(args[1]) or "", args[2])]
        for description, command in pairs:
            command = command_text(command)
            if name == "o.bind_toggle":
                command = "omarchy-toggle-" + command
            parsed.binds.setdefault(normalize_keys(keys), []).append(Bind(description, command, source, keys))


def parse_helpers(text, parsed, source):
    """Note every binding helper the parser has no rule for."""
    for match in HELPER.finditer(blank_comments(text)):
        name = match.group(1) or match.group(2)
        if name not in HELPERS_READ:
            parsed.helpers[name] = source


def check_tree(root, name):
    missing = [part for part in TREE_PARTS if not (root / part).is_dir() or not any((root / part).iterdir())]
    if missing:
        raise UnusableTree(f"the {name} tree {root} has nothing in {', '.join(missing)}.")


def parse_defaults(root, name):
    parsed = Parsed()
    for path in sorted((root / "default/hypr").rglob("*.lua")):
        text, source = path.read_text(errors="replace"), str(path.relative_to(root))
        parse_helpers(text, parsed, source)
        if path.name != "helpers.lua":
            parse_lua(text, parsed, source)
    if not parsed.binds:
        raise UnusableTree(f"the {name} tree {root} has no readable default bindings, so the format has moved.")
    return parsed


def blocked(path, usable=Path.is_file, wanted="a file"):
    """Why a path can't be read, or None if it can or there's simply nothing there."""
    try:
        path.lstat()
    except FileNotFoundError:
        # A dotfiles folder on an unmounted drive looks just like having no file.
        broken = any(parent.is_symlink() and not parent.exists() for parent in path.parents)
        return "It's a broken link" if broken else None
    except NotADirectoryError:
        return None
    except OSError as error:
        return error.strerror
    # Reading a FIFO would hang, so anything but what's wanted stops here.
    if usable(path):
        return None
    return "It's a broken link" if path.is_symlink() and not path.exists() else f"It isn't {wanted}"


def read_user_bindings(path, shown):
    """The user's bindings, and a finding if the file is there but can't be read."""
    parsed = Parsed()
    reason = blocked(path)
    if reason:
        return parsed, [unreadable_bindings(shown, reason)]
    if not path.exists():
        return parsed, []
    try:
        parse_lua(path.read_text(errors="replace"), parsed, shown)
    except OSError as error:
        return Parsed(), [unreadable_bindings(shown, error.strerror)]
    return parsed, []


def unreadable_bindings(shown, reason):
    return Finding(
        "bindings", UNKNOWN, f"{shown} couldn't be read, so your bindings weren't compared.", [shown], detail=f"{reason}."
    )


def label(binds):
    return " / ".join(dict.fromkeys(bind.description or bind.command for bind in binds))


def sources(*groups):
    return sorted({bind.source for binds in groups for bind in binds})


def spelled(binds):
    """The keys of these binds as written, once for each way of writing them."""
    return list({spelling(bind.keys): bind.keys for bind in binds}.values())


def unbind_calls(binds):
    return " and ".join(f'hl.unbind("{keys}")' for keys in spelled(binds))


def keys(*chords):
    """What a finding about these chords is about. A list of many isn't about any one."""
    return tuple(("keys", chord) for chord in chords)


def same_actions(one, other):
    """Whether two chords do the same. A press alone isn't the same as a press and release pair."""
    return all(any(a.same_action(b) for b in other) for a in one) and all(
        any(b.same_action(a) for a in one) for b in other
    )


def compare_computed(current, target, user):
    before = Counter(computed.expression for computed in current.unread)
    after = Counter(computed.expression for computed in target.unread)
    findings = []
    for expression in sorted(set(before) | set(after)):
        if before[expression] != after[expression]:
            evidence = {c.source for c in current.unread + target.unread if c.expression == expression}
            findings.append(Finding(
                "bindings",
                UNKNOWN,
                f"The computed key {expression} isn't the same in both versions, so it wasn't compared.",
                sorted(evidence),
                detail="It could land on one of your keys.",
                partial=True,
            ))
    for expression in sorted({computed.expression for computed in user.unread}):
        findings.append(Finding(
            "bindings",
            UNKNOWN,
            f"Your computed key {expression} wasn't compared.",
            sorted({c.source for c in user.unread if c.expression == expression}),
            detail="It could clash with a default.",
            partial=True,
        ))
    same = before & after
    if same:
        evidence = {c.source for c in current.unread + target.unread if c.expression in same}
        findings.append(Finding(
            "bindings",
            NOTE,
            f"{same.total()} key bindings use computed keys and weren't compared.",
            sorted(evidence),
        ))
    return findings


def compare_bindings(current, target, user):
    cur, tgt = current.binds, target.binds
    changed = {c for c in cur if c not in tgt or not same_actions(cur[c], tgt[c])}
    arrived = {c for c in tgt if c not in cur or not same_actions(cur[c], tgt[c])}
    findings = []

    def turned_off(chord, binds):
        return all(spelling(bind.keys) in user.unbinds.get(chord, {}) for bind in binds)

    taken_over = {c for c in arrived if c in cur and c not in user.binds}
    moved = {}
    for chord in sorted(changed):
        for other in sorted(arrived - {chord}):
            if same_actions(cur[chord], tgt[other]):
                moved[chord] = other
                break

    for chord in sorted(user.binds):
        mine = user.binds[chord]
        if chord not in arrived or turned_off(chord, tgt[chord]):
            continue
        findings.append(Finding(
            "bindings",
            ATTENTION,
            f'{chord}: your "{label(mine)}" will clash with the new default "{label(tgt[chord])}".',
            sources(mine, tgt[chord]),
            detail="Both will fire.",
            # Below your binding it would turn that off as well.
            fix=f"Add {unbind_calls(tgt[chord])} above your binding, or choose another key.",
            about=keys(chord),
        ))

    for chord in sorted(user.unbinds):
        if chord not in cur or not turned_off(chord, cur[chord]):
            continue
        unbound = sorted(set(user.unbinds[chord].values()))
        if chord in moved:
            if not turned_off(moved[chord], tgt[moved[chord]]):
                findings.append(Finding(
                    "bindings",
                    ATTENTION,
                    f'{chord}: you turned off "{label(cur[chord])}" here, but it moves to '
                    f"{moved[chord]}, so it comes back.",
                    [*unbound, *sources(cur[chord], tgt[moved[chord]])],
                    fix=f"Add {unbind_calls(tgt[moved[chord]])} too.",
                    about=keys(chord, moved[chord]),
                ))
        elif chord not in tgt:
            findings.append(Finding(
                "bindings",
                NOTE,
                f"{chord}: your unbind no longer does anything, the default is gone.",
                [*unbound, *sources(cur[chord])],
                about=keys(chord),
            ))
        elif chord in arrived and chord in user.binds and turned_off(chord, tgt[chord]):
            findings.append(Finding(
                "bindings",
                NOTE,
                f'{chord}: your binding now replaces "{label(tgt[chord])}", '
                f'not "{label(cur[chord])}".',
                sources(user.binds[chord], tgt[chord]),
                about=keys(chord),
            ))

    # A move is one change, with what it replaced and what took its place. A key that
    # another move accounts for is told there.
    for chord, other in sorted(moved.items()):
        title, evidence = f'Moved: "{label(cur[chord])}" from {chord} to {other}', [cur[chord], tgt[other]]
        if other in taken_over and other not in moved:
            title += f', replacing "{label(cur[other])}"'
            evidence.append(cur[other])
        title += "."
        if chord in taken_over and chord not in moved.values():
            title += f' {chord} is now "{label(tgt[chord])}".'
            evidence.append(tgt[chord])
        findings.append(Finding("bindings", NOTE, title, sources(*evidence), about=keys(chord, other)))

    for chord in sorted(taken_over - set(moved) - set(moved.values())):
        findings.append(Finding(
            "bindings",
            NOTE,
            f'{chord} is now "{label(tgt[chord])}", it was "{label(cur[chord])}".',
            sources(cur[chord], tgt[chord]),
            about=keys(chord),
        ))

    fresh = sorted(
        c for c in arrived
        if c not in cur and c not in moved.values() and c not in user.binds and not c.startswith("SWITCH:")
    )
    if fresh:
        lines = ", ".join(f'{c} ("{label(tgt[c])}")' for c in fresh)
        findings.append(Finding(
            "bindings", NOTE, f"New default shortcuts: {lines}.", sources(*(tgt[c] for c in fresh))
        ))

    gone = sorted(c for c in changed if c not in moved and c not in tgt and not turned_off(c, cur[c]))
    if gone:
        lines = ", ".join(f'{c} ("{label(cur[c])}")' for c in gone)
        findings.append(Finding(
            "bindings", NOTE, f"Default shortcuts removed: {lines}.", sources(*(cur[c] for c in gone))
        ))

    for name, source in sorted({**current.helpers, **target.helpers}.items()):
        findings.append(Finding(
            "bindings",
            UNKNOWN,
            f"The binding helper {name} isn't one this tool can read, so keys bound with it weren't compared.",
            [source],
            partial=True,
        ))

    return [*findings, *compare_computed(current, target, user)]


def installed_packages():
    try:
        output = subprocess.run(["pacman", "-Qq"], capture_output=True, text=True, check=True).stdout
    except (OSError, subprocess.CalledProcessError):
        return None
    return set(output.split())


def line_end(text, index):
    end = text.find("\n", index)
    return len(text) if end < 0 else end


def closing(text, index, opener, closer, quoted=False):
    """Where the bracket opened just before index ends. Inside double quotes ' is a letter."""
    depth = 1
    while depth:
        if index >= len(text):
            raise ShellUnread
        char = text[index]
        if char == '"' or (char == "'" and not quoted):
            index = string_end(text, index)
        elif char == "#" and not quoted and text[index - 1] in " \t\n":
            index = line_end(text, index)
        else:
            depth += (char == opener) - (char == closer)
            index += 2 if char == "\\" else 1
    return index


def heredoc_end(text, index, heredocs):
    """Where the bodies of the heredocs starting at index end."""
    for delimiter, tabs in heredocs:
        while True:
            if index >= len(text):
                raise ShellUnread
            end = line_end(text, index)
            line = text[index:end]
            index = end + 1
            if (line.lstrip("\t") if tabs else line) == delimiter:
                break
    return index


def shell_word(text, index):
    """Read the word at index: its text, the substitutions in it, and where it ends.

    Quotes come off. Whatever is only known at run time keeps a $, so it can never
    pass for a package name. A ${...} stays as written, so $OMARCHY_PATH can be told.
    """
    word, inner, quoted = "", [], False
    while index < len(text):
        char = text[index]
        if char == "\\":
            word += text[index + 1 : index + 2].strip("\n")
            index += 2
        elif char == "'" and not quoted:
            end = text.find("'", index + 1)
            if end < 0:
                raise ShellUnread
            word += text[index + 1 : end]
            index = end + 1
        elif char == '"':
            quoted = not quoted
            index += 1
        elif text.startswith("$((", index):
            index = closing(text, index + 2, "(", ")", quoted)
            word += "$"
        elif text.startswith("$(", index):
            tokens, index = shell_tokens(text, index + 2, True)
            inner.append(tokens)
            word += "$"
        elif text.startswith("${", index):
            end = closing(text, index + 2, "{", "}", quoted)
            word += text[index:end]
            index = end
        elif char == "`":
            end = string_end(text, index)
            if end - 1 == index or text[end - 1] != "`":
                raise ShellUnread
            part = shell_tokens(text[index + 1 : end - 1])[0]
            # Read on its own, so where each word starts moves along to the backtick.
            inner.append([type(t)(t, t.at + index + 1) if isinstance(t, Word) else t for t in part])
            index = end
            word += "$"
        elif char == "(" and not quoted and word.endswith("="):
            index = closing(text, index + 1, "(", ")")
            word += "$"
        elif char in " \t\r\n;&|()<>" and not quoted:
            break
        else:
            word += char
            index += 1
    if quoted:
        raise ShellUnread
    return word, inner, index


def shell_tokens(text, index=0, nested=False):
    """Split shell text into words and Ops, and say where it stopped.

    Comments and heredoc bodies are dropped, and so are redirects, but for the file
    output goes to, which is a Redirect. A substitution comes before the command
    holding it, because it runs first. Nested text stops at its own ).
    """
    tokens, heredocs, start, depth, redirect = [], [], 0, 0, None
    while index < len(text):
        found = SHELL_OPERATOR.match(text, index)
        if text[index] in " \t\r" or text.startswith("\\\n", index):
            index += 2 if text[index] == "\\" else 1
        elif text[index] == "#":
            index = line_end(text, index)
        elif text.startswith(("<(", ">("), index):
            inner, index = shell_tokens(text, index + 2, True)
            tokens[start:start] = [Op("$("), *inner, Op(")")]
            start += len(inner) + 2
            redirect = None
        elif text.startswith("((", index):
            tokens.append(Word("((", index))
            index = closing(text, index + 1, "(", ")")
        elif found and (found.group()[0] in "<>" or found.group().startswith("&>")):
            redirect = found.group()
            index = found.end()
        elif found:
            operator, index = found.group(), found.end()
            if nested and operator == ")" and not depth:
                return tokens, index
            depth += (operator == "(") - (operator == ")")
            if operator == "\n":
                index = heredoc_end(text, index, heredocs)
                heredocs = []
                if tokens and isinstance(tokens[-1], Op) and tokens[-1] in ("&&", "||", "|", "|&"):
                    continue
            tokens.append(Op(operator))
            start = len(tokens)
        else:
            at = index
            word, inner, index = shell_word(text, index)
            for part in inner:
                tokens[start:start] = [Op("$("), *part, Op(")")]
                start += len(part) + 2
            if redirect:
                if redirect.startswith("<<") and redirect != "<<<":
                    heredocs.append((word, redirect == "<<-"))
                elif redirect in OUTPUT_REDIRECTS and not (redirect == ">&" and (word.isdigit() or word == "-")):
                    tokens.append(Redirect(word, at))
                redirect = None
            elif not (word.isdigit() and text[index : index + 1] in ("<", ">")):
                tokens.append(Word(word, at))
            if word == "[[":
                ended = TEST_END.search(text, index)
                if not ended:
                    raise ShellUnread
                index = ended.end()
    if nested:
        raise ShellUnread
    return tokens, index


def pacman_removes(arguments):
    """Whether these pacman arguments remove something. --print only lists it."""
    options = [word for word in arguments if word.startswith("-")]
    short = "".join(word[1:] for word in options if not word.startswith("--"))
    prints = "p" in short or any(word.startswith("--print") for word in options)
    return ("R" in short or "--remove" in options) and not prints


def not_run(words):
    if words[0] == "command":
        return words[1:2] in (["-v"], ["-V"])
    return words[0].rsplit("/", 1)[-1] in NOT_RUN


def package_action(words):
    """What a command does to packages, as an action and its arguments, or None.

    The action is drop, add, unread for a removal in a string, or reach for the
    words that may name other release files.
    """
    reached = []
    for index, word in enumerate(words):
        name, rest = word.rsplit("/", 1)[-1], words[index + 1 :]
        if name == "omarchy" and rest[:1] == ["pkg"]:
            name, rest = "-".join([name, *rest[:2]]), rest[2:]
        if name in PACKAGE_DROPS or (name in PACMANS and pacman_removes(rest)):
            return "drop", rest
        if name in PACKAGE_ADDS:
            return "add", rest
        shell_string = name == "eval" or (name in ("bash", "sh") and any(SHELL_STRING_FLAG.fullmatch(part) for part in rest))
        if shell_string and any(NAMES_REMOVAL.search(part) for part in rest):
            return "unread", []
        if name in SHELLS:
            reached += [part for part in rest if RELEASE_FILE.fullmatch(part)]
        if RELEASE_FILE.fullmatch(word) and words[:index] in ([], ["sudo"]):
            reached.append(word)
        if name.startswith("omarchy-"):
            reached.append(name)
    return ("reach", reached) if reached else None


def package_commands(text):
    """Each package command in a script, in order: action, arguments, whether it can be skipped."""
    commands, blocks, words = [], [], []
    chained = function = patterns = False

    def enter(conditional):
        nonlocal chained, function
        blocks.append(conditional or chained or function)
        chained = function = False

    def leave():
        nonlocal chained
        if not blocks:
            raise ShellUnread
        chained = blocks.pop()

    for token in [*shell_tokens(text)[0], Op("\n")]:
        if isinstance(token, Redirect):
            continue
        if not isinstance(token, Op):
            words.append(token)
            continue
        if patterns and words[:1] != ["esac"]:
            patterns = token != ")"
            words = []
            continue
        patterns = False
        if token == "()":
            function = True
            words = []
            continue
        while words:
            head = words[0]
            if head in ("if", "while", "until"):
                enter(True)
            elif head in ("for", "select", "case"):
                enter(True)
                patterns = head == "case"
                words = []
                break
            elif head == "{":
                enter(False)
            elif head in ("fi", "done", "esac", "}"):
                leave()
            elif head == "function":
                function = True
                words = words[1:]
            elif head not in ("then", "do", "else", "elif", "!", "time"):
                break
            words = words[1:]
        if patterns:
            patterns = token != ")"
            continue
        if words and not not_run(words):
            action = package_action(words)
            if action:
                commands.append((*action, chained or any(blocks)))
        words = []
        if token in ("(", "$("):
            enter(False)
        elif token == ")":
            leave()
        elif token in ("&&", "||"):
            chained = True
        elif token not in ("|", "|&"):
            chained = False
            patterns = patterns or token in (";;", ";&", ";;&")
    if blocks or patterns:
        raise ShellUnread
    return commands


def release_file(tree, word):
    """The file in the release that a word names, or None. Nothing outside the tree counts."""
    named = RELEASE_FILE.fullmatch(word)
    path = tree / (named.group(1) if named else f"bin/{word.rsplit('/', 1)[-1]}")
    return path if path.is_file() and path.resolve().is_relative_to(tree.resolve()) else None


def reached_commands(tree, words, seen):
    """The package commands in the release files these words name, and in what those reach.

    Each is an action, its arguments, and the file. A file that isn't a shell script
    isn't parsed: it is unread if its text names a removal.
    """
    for word in words:
        path = release_file(tree, word)
        if path is None or path in seen:
            continue
        seen.add(path)
        file = str(path.relative_to(tree))
        text = path.read_text(errors="replace")
        if text.startswith("#!") and not SHELL_SCRIPT.match(text):
            if NAMES_REMOVAL.search(text):
                yield "unread", [], file
            continue
        try:
            commands = package_commands(text)
        except ShellUnread:
            yield "unread", [], file
            continue
        for action, arguments, _ in commands:
            if action == "reach":
                yield from reached_commands(tree, arguments, seen)
            else:
                yield action, arguments, file


def migration_commands(path):
    """A migration's package commands, each with whether it can be skipped and any other file."""
    seen = {path}
    for action, arguments, conditional in package_commands(path.read_text(errors="replace")):
        if action == "reach":
            for reached, words, file in reached_commands(path.parent.parent, arguments, seen):
                yield reached, words, True, file
        else:
            yield action, arguments, conditional


def package_changes(migrations, already_run):
    """What the pending migrations remove: each package, and the migrations it can't read.

    Each package maps to whether its removal is conditional, which migration, and
    the file that holds the removal when that is another one. A migration it can't
    read comes with the other files it couldn't read.
    """
    dropped, unread = {}, {}
    for path in sorted(migrations.glob("*.sh")):
        if path.name in already_run:
            continue
        try:
            commands = list(migration_commands(path))
        except ShellUnread:
            unread[path.name] = set()
            continue
        for action, arguments, conditional, *other in commands:
            packages = [word for word in arguments if not word.startswith("-")]
            readable = [package for package in packages if PACKAGE.fullmatch(package)]
            if action == "unread" or (action == "drop" and (not packages or len(readable) < len(packages))):
                unread.setdefault(path.name, set()).update(other)
            for package in readable:
                certain = package in dropped and not dropped[package][0]
                if action == "drop":
                    if not (conditional and certain):
                        dropped[package] = (conditional, path.name, *other)
                elif other:
                    continue
                elif conditional and package in dropped:
                    dropped[package] = (True, *dropped[package][1:])
                else:
                    dropped.pop(package, None)
    return dropped, {(migration, *sorted(files)) for migration, files in unread.items()}


def migrations_run(home):
    state = home / ".local/state/omarchy/migrations"
    return {p.name for p in state.iterdir()} if state.is_dir() else set()


def compare_packages(target, home, installed, checked):
    if installed is None:
        title = "pacman wasn't available, so packages weren't checked."
        return [Finding("packages", UNKNOWN, title, ["pacman -Qq"])]
    already_run = migrations_run(home)
    dropped, unread = package_changes(target / "migrations", already_run)
    read = sum(p.name not in already_run for p in (target / "migrations").glob("*.sh")) - len(unread)
    if read or not unread:
        checked["packages"] = {"pendingMigrations": read}
    findings = []
    for package in sorted(set(dropped) & installed):
        conditional, migration, *other = dropped[package]
        when = "may remove" if conditional else "will remove"
        after = "If it goes" if conditional else "After the update"
        findings.append(Finding(
            "packages",
            ATTENTION,
            f"The update {when} {package}, which is installed here.",
            [f"migrations/{migration}", *other],
            fix=f"{after}, run omarchy pkg add {package} (aur-add for an AUR package).",
            about=(("migration", f"migrations/{migration}"), ("package", package)),
        ))
    for migration, *files in sorted(unread):
        title = f"Couldn't read what migrations/{migration} removes, so check it by hand."
        if files:
            verb = "removes" if len(files) == 1 else "remove"
            title = f"Couldn't read what {' and '.join(files)} {verb}, called from migrations/{migration}, so check by hand."
        findings.append(Finding("packages", UNKNOWN, title, [f"migrations/{migration}", *files], partial=read > 0))
    return findings


def simple_commands(tokens):
    """Each simple command in shell tokens, as its words, without the words that open or close a block."""
    words = []
    for token in [*tokens, Op("\n")]:
        if not isinstance(token, Op):
            words.append(token)
            continue
        while words and words[0] in BLOCK_WORDS and not isinstance(words[0], Redirect):
            words = words[1:]
        if words:
            yield words
        words = []


def brace_end(word, index):
    """Where the brace opened just before index closes, past its }."""
    depth = 1
    while index < len(word) and depth:
        depth += (word[index] == "{") - (word[index] == "}")
        index += 1
    return index


def braces(word):
    """A word with its {a,b} lists spelled out, as bash does first. A ${...} isn't a list."""
    index = word.find("{")
    while index >= 0:
        end = brace_end(word, index + 1)
        inner = word[index + 1 : end - 1]
        if word[index - 1 : index] != "$" and word[end - 1] == "}" and "," in inner and "{" not in inner:
            return [out for part in inner.split(",") for out in braces(word[:index] + part + word[end:])]
        index = word.find("{", end if word[index - 1 : index] == "$" else index + 1)
    return [word]


def cut(text, operator, pattern):
    """text without the shortest start (#), longest start (##), shortest end (%) or longest end (%%) that pattern matches."""
    if operator[0] == "#":
        ends = range(len(text) + 1) if operator == "#" else range(len(text), -1, -1)
        return next((text[end:] for end in ends if fnmatch.fnmatchcase(text[:end], pattern)), text)
    starts = range(len(text), -1, -1) if operator == "%" else range(len(text) + 1)
    return next((text[:start] for start in starts if fnmatch.fnmatchcase(text[start:], pattern)), text)


def stripped(values, operator, pattern, variables, home):
    """What values are with what pattern matches cut off, as ${name#pattern} and its like cut it."""
    try:
        text, inner, end = shell_word(pattern, 0)
    except ShellUnread:
        return [("", False)]
    patterns = expansions(text, variables, home) if end == len(pattern) and not inner else [("", False)]
    # A quoted * matches only itself, which fnmatch can't tell from one that matches anything.
    quoted = re.search(r"[\"'\\]", pattern) is not None
    if any(not whole or (quoted and re.search(r"[*?[]", glob_text)) for glob_text, whole in patterns):
        return [("", False)]
    found = [(cut(text, operator, glob_text), True) if whole else ("", False) for text, whole in values for glob_text, _ in patterns]
    return list(dict.fromkeys(found))


def parameter(inner, variables, home):
    """What ${inner} can stand for.

    A name or a function's argument can have a default, or a pattern to cut off.
    Anything else is only known when it runs.
    """
    found = PARAMETER.fullmatch(inner)
    if not found:
        return [("", False)]
    name, operator, rest = found.groups()
    if name in variables:
        values = variables[name]
    elif name == "HOME":
        values = [(str(home), True)]
    elif name == "OMARCHY_PATH":
        values = [(INSTALLED, True)]
    elif not NAME.fullmatch(name):
        # Arguments are only known inside a function the script calls: see script_values.
        return [("", False)]
    else:
        # One the script doesn't set is taken as unset, so its default holds.
        values = [("", operator is not None and operator[-1] in "-=")]
    if not operator:
        return values
    if operator[-1] not in "-=":
        return stripped(values, operator, rest, variables, home)
    fallback = expansions(rest, variables, home)
    return list(dict.fromkeys(part for value in values for part in (fallback if value == ("", True) else [value])))


def expanded(word, variables, home):
    values, index = [("", True)], 0
    if word == "~" or word.startswith("~/"):
        values, index = [(str(home), True)], 1
    while index < len(word):
        if word[index] != "$":
            end = word.find("$", index)
            end = len(word) if end < 0 else end
            parts, index = [(word[index:end], True)], end
        elif word.startswith("${", index):
            end = brace_end(word, index + 2)
            parts, index = parameter(word[index + 2 : end - 1], variables, home), end
        else:
            # $1 and $@ are a function's arguments. $#, $? and what shell_word left of a $(...) are only known when it runs.
            name = UNBRACED.match(word, index + 1)
            parts, index = (parameter(name.group(), variables, home), name.end()) if name else ([("", False)], len(word))
        values = list(dict.fromkeys(
            (text + more, whole) if known else (text, known) for text, known in values for more, whole in parts
        ))
        if len(values) > MOST_EXPANSIONS:
            return [("", False)]
    return values


def expansions(word, variables, home):
    """What a shell word can stand for, each as its text and whether that is all of it.

    The text stops at a part that is only known when the script runs, such as $1 or
    a $(...). HOME is the home being read, and a variable the script doesn't set
    takes its default, as in ${XDG_CONFIG_HOME:-$HOME/.config}.
    """
    found = list(dict.fromkeys(value for part in braces(word) for value in expanded(part, variables, home)))
    return found if len(found) <= MOST_EXPANSIONS else [("", False)]


def substituted(words, variables, home):
    """What a $(...) of this command stands for as a path, if it's one this can tell, or None.

    mktemp makes its file by its template, or in the folder for temporary files,
    which isn't yours, when it has none. realpath and readlink -f name the file
    they're given.
    """
    name, arguments = words[0], operands(words[1:], "pt")
    if name == "mktemp":
        if any(word.startswith(("-p", "-t", "--tmpdir")) for word in words[1:]):
            return [("", False)]
        return expansions(arguments[0], variables, home) if arguments else []
    if (name == "realpath" or (name == "readlink" and "-f" in words)) and len(arguments) == 1:
        return expansions(arguments[0], variables, home)
    return None


def held_too(held, values):
    held.extend(value for value in values if value not in held)


def script_variables(commands, home, arguments):
    """What each variable a script sets can hold, from every place that sets it, in order.

    arguments gives what a command's $1, $2 and "$@" hold, if they are known.
    """
    variables, previous = {}, []

    def assign(name, values):
        held_too(variables.setdefault(name, []), values)

    for words in commands:
        head, known = words[0], ChainMap(arguments(words), variables)
        if head in ("for", "select") and len(words) > 1 and NAME.fullmatch(words[1]):
            listed = words[3:] if words[2:3] == ["in"] else None
            assign(words[1], [("", False)] if listed is None else [
                value for word in listed for value in expansions(word, known, home)
            ])
        elif head in ("read", "mapfile", "readarray"):
            for name in words[1:]:
                if NAME.fullmatch(name):
                    assign(name, [("", False)])
        else:
            declared = words[1:] if head in DECLARES else words
            settings = [word for word in declared if ASSIGNMENT.match(word)]
            # An assignment before a command is only for that command.
            if head in DECLARES or len(settings) == len(words):
                for setting in settings:
                    name, value = setting.split("=", 1)
                    if name.endswith("+"):
                        assign(name[:-1], [("", False)])
                    else:
                        # A $(...) comes just before the command holding it.
                        path = substituted(previous, ChainMap(arguments(previous), variables), home) if value == "$" else None
                        assign(name, expansions(value, known, home) if path is None else path)
        previous = words
    return variables


def operands(arguments, valued=""):
    """The arguments that aren't options. A short option in valued takes the next word."""
    found, words = [], iter(arguments)
    for word in words:
        if word == "--":
            found += words
        elif word.startswith("-") and len(word) > 1:
            if not word.startswith("--") and word[-1] in valued:
                next(words, None)
        else:
            found.append(word)
    return found


def sed_files(arguments):
    """The files sed edits in place. Without -i it edits none."""
    in_place, script, files, words = False, False, [], iter(arguments)
    for word in words:
        if word == "--":
            files += words
        elif word.startswith("--"):
            in_place = in_place or word.startswith("--in-place")
            script = script or word.startswith(("--expression", "--file"))
            if word in ("--expression", "--file"):
                next(words, None)
        elif word.startswith("-") and len(word) > 1:
            for index, letter in enumerate(word[1:], 2):
                # What follows -i is a backup suffix, and what follows -e, -f or -l is its value.
                if letter == "i":
                    in_place = True
                    break
                if letter in "efl":
                    script = script or letter != "l"
                    if index == len(word):
                        next(words, None)
                    break
        else:
            files.append(word)
    return (files if script else files[1:]) if in_place else []


def braced(token, brace):
    return type(token) is Word and token == brace


def function_bodies(tokens):
    """Each function a script defines: the word that names it, and where in tokens the { and } of its body are."""
    found = []
    for index, token in enumerate(tokens):
        if braced(token, "function") and index + 1 < len(tokens) and type(tokens[index + 1]) is Word:
            name, start = tokens[index + 1], index + 2
        elif isinstance(token, Op) and token == "()" and index and type(tokens[index - 1]) is Word:
            if index > 1 and braced(tokens[index - 2], "function"):
                continue
            name, start = tokens[index - 1], index + 1
        else:
            continue
        while start < len(tokens) and isinstance(tokens[start], Op) and tokens[start] in ("()", "\n"):
            start += 1
        if start == len(tokens) or not braced(tokens[start], "{"):
            continue
        depth, end = 0, start
        for end in range(start, len(tokens)):
            depth += braced(tokens[end], "{") - braced(tokens[end], "}")
            if not depth:
                break
        found.append((name, start, end))
    return found


def wrapper_functions(tokens):
    """The functions a script defines that run the command they're given, and whether they run it with sudo."""
    found = {}
    for name, start, end in function_bodies(tokens):
        runs = [words for words in simple_commands(tokens[start + 1 : end]) if "$@" in words or "${@}" in words]
        if runs:
            found[name] = any(word == "sudo" or found.get(word) for words in runs for word in words)
    return found


def argument_scope(tokens, commands, bodies):
    """A function giving the function whose arguments a command's $1 and "$@" are, or None if they're only known when it runs.

    That is the innermost function the command is in. After that function's first
    shift or set they could be anything, and so they are anywhere in it if one of
    those is in a loop.
    """
    spans = [(tokens[start].at, tokens[end].at, name) for name, start, end in bodies]
    loops = [(token.at, 1 if token == "do" else -1) for index, token in enumerate(tokens) if (
        type(token) is Word and token in ("do", "done") and (not index or isinstance(tokens[index - 1], Op))
    )]

    def innermost(at):
        return max((span for span in spans if span[0] < at < span[1]), default=None)

    shifted = {}
    for words in commands:
        moves = words[0] == "shift" or (words[0] == "set" and any(
            word == "--" or not word.startswith(("-", "+")) for word in words[1:]
        ))
        span = innermost(words[0].at) if moves else None
        if span:
            in_loop = sum(step for at, step in loops if span[0] < at < words[0].at) > 0
            first = shifted.get(span, words[0].at)
            shifted[span] = -1 if in_loop or first < 0 else min(first, words[0].at)

    def scope(words):
        span = innermost(words[0].at) if words else None
        moved = shifted.get(span)
        return None if span is None or (moved is not None and (moved < 0 or words[0].at > moved)) else span[2]

    return scope


def function_calls(commands, bodies):
    """The commands that call a function the script defines, as the function's name and its arguments."""
    names, naming = {name for name, _, _ in bodies}, {name.at for name, _, _ in bodies}
    for words in commands:
        words = list(itertools.dropwhile(ASSIGNMENT.match, [word for word in words if not isinstance(word, Redirect)]))
        # A function's own name where it's defined isn't a call.
        if words and words[0] in names and words[0].at not in naming:
            yield words


def function_arguments(calls, values):
    """What each function's $1, $2 and so on, and "$@", can hold: what each call passes, as values reads it.

    An argument a call doesn't pass is empty. Past a "$@" any argument can land
    anywhere, so each later one can hold any of them.
    """
    passed = {}
    for words in calls:
        passed.setdefault(words[0], []).append([(word, values(words, word)) for word in words[1:]])
    found = {}
    for name, lists in passed.items():
        numbers = range(1, max(9, *map(len, lists)) + 1)
        held = found[name] = {str(number): [] for number in numbers} | {"@": []}
        for arguments in lists:
            spread = next((index for index, (word, _) in enumerate(arguments) if word in ("$@", "${@}")), len(arguments))
            for number in numbers:
                if number > spread:
                    held_too(held[str(number)], [value for _, parts in arguments[spread:] for value in parts] + [("", True)])
                else:
                    held_too(held[str(number)], arguments[number - 1][1] if number <= len(arguments) else [("", True)])
            held_too(held["@"], [value for _, parts in arguments for value in parts])
    return found


def script_values(tokens, commands, home):
    """What each variable a script sets can hold, and a function giving what a command's $1, $2 and "$@" hold.

    A function's arguments hold what every call to it passes, read as any other
    word is, so the script is read again until what they hold settles. A function
    no call reaches, or one that never settles, as when it calls itself with a
    longer path each time, has arguments only known when it runs.
    """
    bodies = function_bodies(tokens)
    scope, calls = argument_scope(tokens, commands, bodies), list(function_calls(commands, bodies))

    def arguments(words):
        return positional.get(scope(words), {})

    def settled(held):
        return {name: {number: set(values) for number, values in numbers.items()} for name, numbers in held.items()}

    # Until a call has been read, the arguments it passes hold nothing.
    positional = function_arguments(calls, lambda words, word: [])
    for _ in range(MOST_PASSES):
        variables = script_variables(commands, home, arguments)
        found = function_arguments(calls, lambda words, word, held=variables: expansions(word, ChainMap(arguments(words), held), home))
        if settled(found) == settled(positional):
            return variables, arguments
        positional = found
    positional = {}
    return script_variables(commands, home, arguments), arguments


def writer_at(words, wrappers):
    """Where in a command its writer is, or None, and whether sudo runs it.

    It is the first word, or comes behind commands that run their arguments: one
    of RUNNERS, past its options, or a function of the script's own that runs
    "$@", past any arguments of its own.
    """
    index, sudo = 0, False
    while index < len(words):
        name = words[index].rsplit("/", 1)[-1]
        if ASSIGNMENT.match(words[index]):
            index += 1
        elif name in WRITERS:
            return index, sudo
        elif name in RUNNERS:
            sudo = sudo or name in ("sudo", "doas")
            index += 1
            # A timeout comes before the command it runs.
            positional = name == "timeout"
            while index < len(words) and (words[index].startswith("-") or ASSIGNMENT.match(words[index]) or positional):
                if words[index].startswith("-"):
                    index += 1 + (not words[index].startswith("--") and words[index][-1] in RUNNERS[name])
                else:
                    positional = positional and ASSIGNMENT.match(words[index]) is not None
                    index += 1
        elif words[index] in wrappers:
            sudo = sudo or wrappers[words[index]]
            later = [i for i in range(index + 1, len(words)) if words[i].rsplit("/", 1)[-1] in {*WRITERS, *RUNNERS}]
            if not later:
                return None, sudo
            index = later[0]
        else:
            return None, sudo
    return None, sudo


def find_changes(arguments, wrappers):
    """Whether find changes what it finds: -delete, or a writer or a shell string that -exec and its like run."""
    if "-delete" in arguments:
        return True
    for index, word in enumerate(arguments):
        if word in ("-exec", "-execdir", "-ok", "-okdir"):
            run = list(itertools.takewhile(lambda part: part not in (";", "+"), arguments[index + 1 :]))
            shell = run[:1] and run[0].rsplit("/", 1)[-1] in ("sh", "bash", "dash", "zsh")
            if writer_at(run, wrappers)[0] is not None or (shell and any(SHELL_STRING_FLAG.fullmatch(part) for part in run)):
                return True
    return False


def written(words, wrappers):
    """The words a command writes to, the folders it searches to change what it finds, and whether sudo runs it.

    The writer is the first word, or comes behind commands that run their arguments:
    see writer_at. Each word comes
    with whether the command only removes it, the words it copies or links, as one
    copied into a folder keeps its name there, and for a link, ln's -T or -n, or
    "" for neither. That is None for anything but a link.
    """
    targets = [(word, False, [], None) for word in words if isinstance(word, Redirect)]
    words = [word for word in words if not isinstance(word, Redirect)]
    if not words or not_run(words):
        return targets, [], False
    found, sudo = writer_at(words, wrappers)
    if found is None:
        return targets, [], sudo
    name, arguments = words[found].rsplit("/", 1)[-1], words[found + 1 :]
    options = [word for word in arguments if word.startswith("-")]
    if name == "sed":
        targets += [(word, False, [], None) for word in sed_files(arguments)]
    elif name in ("rm", "tee"):
        targets += [(word, name == "rm", [], None) for word in operands(arguments)]
    elif name == "find":
        starts = list(itertools.takewhile(lambda word: not word.startswith(("-", "(", "!")), arguments)) or ["."]
        return targets, starts if find_changes(arguments, wrappers) else [], sudo
    elif name == "ln":
        linked = operands(arguments, "St")
        short = "".join(word[1:] for word in options if not word.startswith("--"))
        # -T never links into a folder, and -n not into one a link names.
        stays = "T" if "T" in short or "--no-target-directory" in options else ""
        stays = stays or ("n" if "n" in short or "--no-dereference" in options else "")
        if "f" in short or "--force" in options:
            targets += [(linked[-1] if len(linked) > 1 else ".", False, linked[:1], stays)]
    elif name in ("mv", "cp") or (name == "install" and "-d" not in arguments):
        copied = operands(arguments, "St" if name == "mv" else "gmoSt")
        if name == "mv":
            targets += [(word, True, [], None) for word in copied[:-1]]
        targets += [(copied[-1], False, copied[:-1], None)] if copied else []
    return targets, [], sudo


def copied_into(place, word, sources, stays, variables, home):
    """What a copy or link to a place writes: the place, or the files of the same name in it when it's a folder."""
    folder = word.endswith("/") or (place.is_dir() and stays != "T" and not (stays == "n" and place.is_symlink()))
    if not sources or not folder:
        return [(str(place), True)]
    found = [(text, known) for source in sources for text, known in expansions(source, variables, home)]
    return [(str(place / Path(text).name), True) if known else ("", False) for text, known in found]


def linked_already(place, sources, variables, home):
    """Whether a link is already there and points where the new one would."""
    if not place.is_symlink():
        return False
    pointed = os.readlink(place)
    return any(known and text == pointed for source in sources for text, known in expansions(source, variables, home))


def your_path(value, home):
    """Where a path a script writes leads: one of your files, False for anywhere else, or None if it can't tell."""
    text, known = value
    path = Path(text)
    if not text.startswith("/"):
        # Relative to wherever the migration runs, or wholly unknown.
        return None
    if any(path.is_relative_to(home / folder) for folder in NOT_YOURS):
        return False
    if path.is_relative_to(home):
        return path if known else None
    return None if not known and str(home).startswith(text) else False


def wildcard(path, home):
    return re.search(r"[*?[]", str(path)[len(str(home)) :]) is not None


def existing(path, home):
    """The files in your home a path names, with its wildcards matched as bash matches them."""
    if wildcard(path, home):
        return sorted(Path(found) for found in glob.glob(glob.escape(str(home)) + str(path)[len(str(home)) :]))
    return [path] if path.exists() or path.is_symlink() else []


def script_writes(text, home):
    """The paths in your home a script writes, and the lines where it can't tell what they write.

    Each write is the paths one word names, sorted: a loop or a function's calls can
    give it several, and a path can hold wildcards. It maps to the lines that write
    it, and whether those only remove it. A path only known when it runs is a line
    it can't tell about, unless sudo runs the command: that is for system files.
    """
    tokens = shell_tokens(text)[0]
    commands = list(simple_commands(tokens))
    (variables, arguments), wrappers = script_values(tokens, commands, home), wrapper_functions(tokens)
    paths, unclear = {}, set()
    for words in commands:
        known = ChainMap(arguments(words), variables)
        targets, searched, sudo = written(words, wrappers)
        line = text.count("\n", 0, words[0].at) + 1
        for word, removes, sources, stays in targets:
            places = set()
            for value in expansions(word, known, home):
                folder = your_path(value, home)
                for path in copied_into(folder, word, sources, stays, known, home) if folder else [value]:
                    place = your_path(path, home)
                    if place is None and not sudo:
                        unclear.add(line)
                    elif place and not (stays is not None and linked_already(place, sources, known, home)):
                        places.add(place)
            if places:
                lines, only_removes = paths.get(tuple(sorted(places)), (set(), True))
                paths[tuple(sorted(places))] = (lines | {line}, only_removes and removes)
        # What find changes is only known when it runs.
        for word in searched:
            for value in expansions(word, known, home):
                place = your_path(value, home)
                if (place is None and not sudo) or (place and existing(place, home)):
                    unclear.add(line)
    return paths, sorted(unclear)


def same_bytes(path, other):
    try:
        return path.stat().st_size == other.stat().st_size and path.read_bytes() == other.read_bytes()
    except OSError:
        return False


def omarchy_default(path, home, trees):
    """Where in a tree Omarchy keeps the default of a file in your home, if it has one, and whether the file is that."""
    for mine, shipped in DEFAULT_FOLDERS:
        if path.is_relative_to(home / mine):
            relative = Path(shipped) / path.relative_to(home / mine)
            defaults = [tree / relative for tree in trees if (tree / relative).is_file()]
            return (str(relative) if defaults else None), any(same_bytes(path, default) for default in defaults)
    return None, False


def listed(items):
    items = list(map(str, items))
    return " and ".join([", ".join(items[:-1]), items[-1]] if len(items) > 1 else items)


def on_lines(numbers):
    return f"{'line' if len(numbers) == 1 else 'lines'} {listed(numbers)}"


def edit_finding(migration, places, lines, removes, changed, home):
    """The note for the files of yours a migration looks like it writes at one path, or at the paths one word names."""
    place = places[0]
    shown = str(place).replace(str(home), "~", 1)
    verb = "removes" if removes else "edits"
    evidence = [f"{migration}:{line}" for line in sorted(lines)]
    detail = "It is read, not run, so the result isn't known. omaforecast can show it by running the migration in a sandbox."
    where = f"{migration}, {on_lines(sorted(lines))}, looks like it {verb}"
    if len(places) > 1:
        title = f"{where} {len(changed)} files of yours that aren't Omarchy's default."
        names = listed(str(path).replace(str(home), "~", 1) for path, _ in changed)
        detail = f"They are {names}. It may {verb[:-1]} only some. {detail}"
    elif wildcard(place, home):
        folder = next(parent for parent in place.parents if not wildcard(parent, home))
        names = listed(str(path.relative_to(folder)) for path, _ in changed)
        title = (
            f"{where} files that match {shown}, and {len(changed)} of them "
            f"{'is' if len(changed) == 1 else 'are'}n't Omarchy's default."
        )
        shown_folder = str(folder).replace(str(home), "~", 1)
        detail = f"{'It is' if len(changed) == 1 else 'They are'} {names}, in {shown_folder}. It may {verb[:-1]} only some. {detail}"
    elif place.is_dir():
        title = f"{where} the folder {shown}."
    elif changed[0][1]:
        title = f"{where} {shown}, which differs from Omarchy's default."
    else:
        title = f"{where} {shown}, which Omarchy has no default for."
    for path, default in changed:
        evidence += [str(path).replace(str(home), "~", 1), *([default] if default else [])]
    return Finding("edits", NOTE, title, evidence, detail=detail, about=(("migration", migration),))


def compare_edits(current, target, home, checked):
    """Your files that pending migrations look like they write, unless they are Omarchy's default."""
    home = home.absolute()
    already_run = migrations_run(home)
    findings, unknown, read = [], [], 0
    for path in sorted((target / "migrations").glob("*.sh")):
        if path.name in already_run:
            continue
        migration = f"migrations/{path.name}"
        try:
            paths, unclear = script_writes(path.read_text(errors="replace"), home)
        except ShellUnread:
            title = f"Couldn't read which files {migration} writes, so check it by hand."
            unknown.append(Finding("edits", UNKNOWN, title, [migration]))
            continue
        read += 1
        for places, (lines, removes) in sorted(paths.items()):
            changed = []
            for file in dict.fromkeys(file for place in places for file in existing(place, home)):
                default, unchanged = omarchy_default(file, home, (current, target))
                if not unchanged:
                    changed.append((file, default))
            # Of several paths, one that is yours is a note on its own.
            if len(places) > 1 and len(changed) == 1:
                places = (changed[0][0],)
            if changed:
                findings.append(edit_finding(migration, places, lines, removes, changed, home))
        if unclear:
            unknown.append(Finding(
                "edits",
                UNKNOWN,
                f"Couldn't tell which files {migration} writes on {on_lines(unclear)}, so check it by hand."
                if len(unclear) <= 3 else
                f"Couldn't tell which files {migration} writes on {len(unclear)} of its lines, so check it by hand.",
                [f"{migration}:{line}" for line in unclear],
                detail="The path is only known when it runs, and could be one of yours.",
            ))
    if read or not unknown:
        checked["edits"] = {"pendingMigrations": read}
    for finding in unknown:
        finding.partial = read > 0
    return [*findings, *unknown]


def walked_files(root, seen, own=()):
    """A folder's files, and why for any folder in it that can't be read.

    Links are followed, but each real folder is read once, so a link loop ends.
    A folder whose real path is in one of the own paths isn't gone into.
    """
    denied = []
    for directory, subdirs, names in os.walk(root, followlinks=True, onerror=denied.append):
        if is_own(directory, own):
            subdirs.clear()
            continue
        status = os.stat(directory)
        if (status.st_dev, status.st_ino) in seen:
            subdirs.clear()
            continue
        seen.add((status.st_dev, status.st_ino))
        # systemd's .wants folders only hold links, mostly to units a package owns.
        subdirs[:] = [d for d in subdirs if d != ".git" and not d.endswith((".wants", ".requires"))]
        yield from ((Path(directory) / name, None) for name in names)
    yield from ((Path(error.filename), error.strerror) for error in denied)


def is_own_plugin(folder):
    """Whether a plugin's manifest.json has this tool's id. One that can't be read doesn't."""
    path = folder / "manifest.json"
    # A pipe would wait for a writer, and the plugin runs this unattended. os.path.isfile,
    # unlike Path.is_file on Python 3.11, is False for a folder that can't be read.
    if not os.path.isfile(path):
        return False
    try:
        manifest = json.loads(path.read_bytes())
    except (OSError, ValueError, RecursionError):
        return False
    return isinstance(manifest, dict) and manifest.get("id") == PLUGIN_ID


def own_paths(home):
    """The tool's own files and folders, by real path, so no check reads them as your setup.

    The running command, the checkout it is in when that holds this tool's manifest, and
    any plugin with this tool's id. The plugin is the whole repository, and its tests name
    deleted commands on purpose. A folder that holds your home is never one, as that would
    leave out everything.
    """
    plugins, _ = plugin_folders(home / ".config/omarchy/plugins")
    checkout = [CHECKOUT] if is_own_plugin(CHECKOUT) else []
    found = {COMMAND, *checkout, *(real_path(p) for p in plugins if os.path.isdir(p) and is_own_plugin(p))}
    home = real_path(home)
    return {folder for folder in found if not home.is_relative_to(folder)}


def real_path(path):
    """Where a path really is. realpath, unlike resolve, never raises on a link loop."""
    return Path(os.path.realpath(path))


def is_own(path, own):
    """Whether a file or folder really is, or sits in, one of the tool's own paths."""
    real = real_path(path)
    return any(real.is_relative_to(folder) for folder in own)


def user_files(home):
    """Each file that can call a command, with why it can't be read, if it can't.

    The tool's own files are left out, wherever they are linked from.
    """
    config = home / ".config"
    by_suffix = [config / "hypr", *(config / "omarchy" / name for name in ("hooks", "extensions", "plugins"))]
    # A script needs no suffix here, and a binary is told by its bytes.
    every_file = [home / ".local/bin", config / "systemd/user", home / ".local/share/applications"]
    own = own_paths(home)
    seen = set()
    # These come first, so a folder linked from both is read in full.
    for root in [*every_file, *by_suffix]:
        reason = blocked(root, Path.is_dir, "a folder")
        if reason:
            yield root, reason
        elif root.exists():
            for path, reason in walked_files(root, seen, own):
                if is_own(path, own):
                    continue
                if reason:
                    yield path, reason
                elif ".bak" not in path.name and (root in every_file or path.suffix in TEXT_SUFFIXES):
                    yield path, blocked(path)
    settings = [config / "omarchy/shell.json", config / "omarchy/shell.toml"]
    for path in [*settings, *(home / name for name in STARTUP_FILES)]:
        reason = blocked(path)
        if (reason or path.exists()) and not is_own(path, own):
            yield path, reason


def scanned_bytes(path):
    """A file's bytes and why it couldn't be read. A binary file holds nothing to read."""
    try:
        with path.open("rb") as file:
            data = file.read(LARGEST_SCANNED + 1)
    except OSError as error:
        return b"", error.strerror
    if b"\0" in data:
        return b"", None
    if len(data) > LARGEST_SCANNED:
        return b"", f"It's over {LARGEST_SCANNED // (1024 * 1024)} MiB"
    return data, None


def shipped_files(root):
    """A tree's files by size, so a copy is only compared with a few of them."""
    sizes = {}
    for path in root.rglob("*"):
        if path.is_file():
            sizes.setdefault(path.stat().st_size, []).append(path)
    return sizes


def shipped_copy(data, root, shipped):
    """Which file in the tree has exactly these bytes, if any."""
    for path in shipped.get(len(data), []):
        try:
            if path.read_bytes() == data:
                return str(path.relative_to(root))
        except OSError:
            continue
    return None


def compare_commands(current, target, home, checked):
    removed = {p.name for p in (current / "bin").glob("omarchy-*")}
    removed -= {p.name for p in (target / "bin").glob("omarchy-*")}
    checked["commands"] = {"deletedCommands": len(removed)}
    if not removed:
        checked["commands"]["yourFiles"] = 0
        return []
    pattern = re.compile(r"(?<![\w-])(" + "|".join(map(re.escape, sorted(removed))) + r")(?![\w-])")
    shipped = shipped_files(current)
    calls, unread, read = [], {}, 0
    for path, reason in user_files(home):
        data, reason = scanned_bytes(path) if reason is None else (b"", reason)
        if reason:
            unread[path] = reason
            continue
        read += 1
        comments = ("--",) if path.suffix == ".lua" else ("#", "//")
        found = {}
        # Not splitlines: it also splits on characters an editor doesn't count as lines.
        for number, line in enumerate(data.decode(errors="replace").split("\n"), 1):
            if line.lstrip().startswith(comments):
                continue
            for command in dict.fromkeys(pattern.findall(line)):
                found.setdefault(command, []).append(number)
        original = shipped_copy(data, current, shipped) if found else None
        calls.extend((str(path), command, numbers, original) for command, numbers in found.items())
    if read or not unread:
        checked["commands"]["yourFiles"] = read
    findings = []
    for path, command, numbers, original in sorted(calls, key=lambda call: call[:2]):
        shown = path.replace(str(home), "~", 1)
        lines = [f"{shown}:{number}" for number in numbers]
        title = f"{shown} calls {command}, which the release deletes."
        about = (("command", command),)
        if original:
            detail = "It's Omarchy's own file, unchanged, so there's nothing for you to fix."
            findings.append(Finding("commands", NOTE, title, [*lines, original], detail=detail, about=about))
        else:
            where = f"line {numbers[0]}" if len(numbers) == 1 else f"lines {', '.join(map(str, numbers))}"
            fix = f"Change or remove {where}. This tool can't tell what replaces the command."
            findings.append(Finding("commands", ATTENTION, title, lines, fix=fix, about=about))
    for path, reason in sorted(unread.items()):
        shown = str(path).replace(str(home), "~", 1)
        title = f"{shown} couldn't be read, so it wasn't checked for deleted commands."
        findings.append(Finding("commands", UNKNOWN, title, [shown], detail=f"{reason}.", partial=read > 0))
    return findings


def in_plugin(path, plugin):
    """Where a file sits in a plugin. One linked in from outside goes by its name."""
    path = Path(path)
    return str(path.relative_to(plugin)) if path.is_relative_to(plugin) else path.name


def qmllint_version(qmllint):
    """What a qmllint says it is, or None if that can't be read."""
    try:
        result = subprocess.run(
            [qmllint, "--version"], capture_output=True, text=True, errors="replace", timeout=LINT_TIMEOUT, check=False,
        )
    except (subprocess.TimeoutExpired, OSError):
        return None
    return QMLLINT_VERSION.fullmatch(result.stdout.strip()) if result.returncode == 0 else None


def find_qmllint():
    """The first qmllint from Qt 6 or newer, and the ones found before it that aren't."""
    others = []
    for qmllint in dict.fromkeys([shutil.which("qmllint"), QMLLINT if Path(QMLLINT).exists() else None]):
        if qmllint:
            version = qmllint_version(qmllint)
            if version and int(version[1]) >= 6:
                return qmllint, others
            others.append((qmllint, version[0] if version else "no version it could read"))
    return None, others


def lint(plugin, shell, qmllint):
    """Count qmllint warnings for a plugin, ignoring line numbers.

    qmllint exits 255 on a syntax error, so warnings can come with a failure.
    """
    files = []
    for path, reason in walked_files(plugin, set()):
        if reason:
            raise LintFailed(f"{path.relative_to(plugin.parent)} couldn't be read: {reason}")
        if path.suffix == ".qml":
            files.append(str(path))
    if not files:
        return Counter()
    with tempfile.TemporaryDirectory() as imports:
        (Path(imports) / "qs").symlink_to(shell.resolve())
        try:
            result = subprocess.run(
                [qmllint, "-I", imports, *sorted(files)],
                capture_output=True, text=True, errors="replace", cwd=plugin, timeout=LINT_TIMEOUT, check=False,
            )
        except subprocess.TimeoutExpired:
            raise LintFailed(f"qmllint ran past {LINT_TIMEOUT} seconds and was stopped") from None
        except OSError as error:
            raise LintFailed(f"qmllint couldn't start: {error.strerror}") from None
    if result.returncode < 0:
        raise LintFailed(f"qmllint died from signal {-result.returncode}")
    warnings = Counter()
    for line in (result.stdout + result.stderr).splitlines():
        unread = re.match(r"(?:Warning|Error): (.+?):: Failed to open file", line)
        if unread:
            raise LintFailed(f"qmllint couldn't open {in_plugin(unread.group(1), plugin)}")
        found = re.match(r"(Warning|Error): (.+?):\d+:\d+: (.*)", line)
        if found:
            warnings[(in_plugin(found.group(2), plugin), found.group(3))] += 1
    if result.returncode and not warnings:
        raise LintFailed(f"qmllint exited {result.returncode} with no warnings to read")
    return warnings


def plugin_folders(plugins):
    """What's in the plugins folder, and why it can't be read, if it can't."""
    reason = blocked(plugins, Path.is_dir, "a folder")
    if reason or not plugins.exists():
        return [], reason
    try:
        # A plain file isn't a plugin, but a broken link could be one.
        return sorted(p for p in plugins.iterdir() if p.is_dir() or not p.exists()), None
    except OSError as error:
        return [], error.strerror


def compare_plugins(current, target, home, checked):
    plugins = home / ".config/omarchy/plugins"
    shown = "~/.config/omarchy/plugins"
    installed, reason = plugin_folders(plugins)
    if reason:
        title = f"{shown} couldn't be read, so plugins weren't linted."
        return [Finding("plugins", UNKNOWN, title, [shown], detail=f"{reason}.")]
    # This tool's own plugin is linted in its CI, and isn't counted.
    own = own_paths(home)
    installed = [p for p in installed if not (p.exists() and is_own(p, own))]
    if not installed:
        checked["plugins"] = {"linted": 0}
        return []
    findings = [
        Finding("plugins", UNKNOWN, f"{p.name} is a broken link, so it wasn't linted.", [f"{shown}/{p.name}"])
        for p in installed if not p.exists()
    ]
    qmllint, others = find_qmllint()
    if others and not qmllint:
        title = "qmllint isn't from Qt 6 or newer, so plugins weren't linted."
        found = ", ".join(f"{str(path).replace(str(home), '~', 1)} ({version})" for path, version in others)
        return [Finding("plugins", UNKNOWN, title, [shown], detail=f"Found {found}."), *findings]
    if not qmllint:
        return [Finding("plugins", UNKNOWN, "qmllint wasn't found, so plugins weren't linted.", [shown]), *findings]
    linted = 0
    for plugin in (p for p in installed if p.exists()):
        try:
            before = lint(plugin.resolve(), current / "shell", qmllint)
            after = lint(plugin.resolve(), target / "shell", qmllint)
        except LintFailed as error:
            title = f"{plugin.name} couldn't be linted, so it wasn't checked for new warnings."
            findings.append(Finding("plugins", UNKNOWN, title, [f"{shown}/{plugin.name}"], detail=f"{error}."))
            continue
        linted += 1
        new = after - before
        if new:
            sample = next(iter(new))
            count = sum(new.values())
            findings.append(Finding(
                "plugins",
                NOTE,
                f"{plugin.name}: {counted(count, 'new qmllint warning')}, such as {sample[0]}: {sample[1]}",
                [f"{shown}/{plugin.name}/{sample[0]}"],
            ))
    if linted:
        checked["plugins"] = {"linted": linted}
        for finding in findings:
            finding.partial = finding.level == UNKNOWN
        findings.append(Finding(
            "plugins",
            NOTE,
            "qmllint can't prove a plugin works. Most plugin breaks only show when the shell runs them.",
            [shown],
        ))
    return findings


def read_notes(tree):
    """The changes listed in a release's notes: each line number, what changed, and where. Empty without notes."""
    path = tree / NOTES
    try:
        text = path.read_text(errors="replace") if path.is_file() else ""
    except OSError:
        return []
    found = ((number, NOTE_ENTRY.fullmatch(line)) for number, line in enumerate(text.split("\n"), 1))
    return [(number, *entry.groups()) for number, entry in found if entry]


def description(path):
    """What a migration says it does: the line it echoes first, as Omarchy's migrations do. None if it doesn't."""
    try:
        words = shell_tokens(path.read_text(errors="replace").split("\n", 1)[0])[0]
    except (OSError, ShellUnread):
        return None
    if [type(word) for word in words] == [Word, Word] and words[0] == "echo" and "$" not in words[1]:
        return words[1]
    return None


def plain_words(text):
    return " ".join(text.casefold().split()).rstrip(".")


def change_names(text, kind, name):
    """Whether a change in the notes clearly names what a finding is about.

    A package may start with a capital, as a name in a sentence does. It counts
    only in a change that removes or replaces, and before the first comma, as what
    comes after one is about something else. A migration goes by what it says it does.
    """
    if kind == "keys":
        return name in {normalize_keys(found) for found in NOTE_KEYS.findall(text)}
    if kind == "migration":
        return plain_words(text) == plain_words(name)
    if kind == "package":
        if not REMOVING.match(text):
            return False
        text = text.partition(",")[0]
    spellings = {name, name[:1].upper() + name[1:]} if kind == "package" else {name}
    # A full stop can end the sentence the name is in.
    pattern = rf"(?<![\w@.+-])(?:{'|'.join(map(re.escape, spellings))})(?![\w@+-]|\.\w)"
    return re.search(pattern, text) is not None


def give_reasons(findings, tree):
    """Link each finding to the change in the release notes it comes from, when one change alone names it.

    Two that name it are unsure, and a wrong reason is worse than none.
    """
    entries = read_notes(tree)
    for finding in findings:
        changes = {}
        for kind, name in finding.about:
            name = description(tree / name) if kind == "migration" else name
            for number, text, reference in entries:
                if name and change_names(text, kind, name):
                    changes.setdefault((text, reference), number)
        if len(changes) == 1:
            ((text, reference), number), = changes.items()
            finding.reason = Reason(text, reference, f"{NOTES}:{number}")


def reviews_file(home):
    """Where reviewed findings are kept. XDG_CONFIG_HOME replaces ~/.config unless it's empty."""
    return Path(os.environ.get("XDG_CONFIG_HOME") or home / ".config") / "omaupdateimpact/reviewed"


def read_reviews(path, name):
    """The ids reviewed for this release. A file that can't be read leaves nothing out, and says so."""
    try:
        text = path.read_text(errors="replace")
    except FileNotFoundError:
        return set()
    except OSError as error:
        print(f"Couldn't read the findings you reviewed, so they all count: {error}", file=sys.stderr)
        return set()
    lines = (line.split() for line in text.split("\n") if not line.lstrip().startswith("#"))
    return {words[1].lower() for words in lines if len(words) >= 2 and words[0] == name}


def record_reviews(path, name, findings, ids, seen):
    """Add the findings with these ids to the reviewed file, for this release, and give their ids.

    Each must need attention in this run, or nothing is written. A limit can't be
    reviewed, as a check that didn't run is never clear. One seen already adds no line.
    """
    by_id = {finding.id: finding for finding in findings}
    wanted = list(dict.fromkeys(given.lower() for given in ids))
    for given in wanted:
        if given not in by_id:
            raise NotReviewable(f"no finding in this report has the id {given}.")
        if by_id[given].level != ATTENTION:
            kind = "a note" if by_id[given].level == NOTE else "a limit"
            raise NotReviewable(f"{given} is {kind}, and only a finding that needs attention can be reviewed.")
    if not TOKEN.fullmatch(name):
        raise NotReviewable(f"the release's name, {name!r}, can't go on a line of {path}.")
    lines = [f"{name} {given} {' '.join(by_id[given].title.split())}\n" for given in wanted if given not in seen]
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a+", encoding="utf-8", errors="surrogateescape") as out:
            # Appended, so a file someone keeps as a link stays one. Its last line may have no newline.
            out.seek(0)
            before = out.read()
            out.write(REVIEWED_HEADER if not before else "" if before.endswith("\n") else "\n")
            out.writelines(lines)
    except (OSError, UnicodeError) as error:
        raise NotReviewable(f"couldn't write {path}: {error}") from error
    print(f"Marked {counted(len(wanted), 'finding')} reviewed for {name}, in {path}.", file=sys.stderr)
    return set(wanted)


def version_key(text):
    """A sort key for a tag or a package version, or None for anything else.

    The tag v4.5.0-rc2 is the package 4.5.0rc2-1, and a pkgrel is the same release.
    """
    found = VERSION.fullmatch(text)
    if not found:
        return None
    major, minor, patch, rc = found.groups()
    return int(major), int(minor), int(patch), float("inf") if rc is None else int(rc)


def is_prerelease(name):
    key = version_key(name)
    return None if key is None else key[3] != float("inf")


def github(url, timeout, token=None, advice="Try again later."):
    request = urllib.request.Request(url)
    if token:
        # urllib carries plain headers along a redirect, whatever host it leads to.
        request.add_unredirected_header("Authorization", f"Bearer {token}")
    try:
        return urllib.request.urlopen(request, timeout=timeout)
    except urllib.error.HTTPError as error:
        with error:
            limited = error.headers.get("x-ratelimit-remaining") == "0" or "retry-after" in error.headers
            if error.code in (403, 429) and limited:
                raise RateLimited(f"GitHub's rate limit is used up. {advice}") from error
            if error.code == 401 and token:
                raise TokenRejected("GitHub rejected GITHUB_TOKEN. Fix it or unset it.") from error
            raise


def api(path):
    token = os.environ.get("GITHUB_TOKEN", "").strip()
    if token and not TOKEN.fullmatch(token):
        # http.client's own complaint would quote the value.
        raise ValueError("GITHUB_TOKEN holds characters a request header can't carry")
    advice = "Try again later." if token else "Try again later, or set GITHUB_TOKEN."
    with github(f"https://api.github.com/repos/{REPO}/{path}", 30, token, advice) as response:
        return json.load(response)


def stable_tag():
    release = api("releases/latest")
    tag = release.get("tag_name") if isinstance(release, dict) else None
    if not isinstance(tag, str) or not TAG.fullmatch(tag):
        raise ValueError("the releases API gave no usable release")
    return tag


def release_tags():
    """Every release tag, newest version first. The API sorts by date, so a stable patch can top an RC."""
    releases = api("releases?per_page=100")
    tags = [r.get("tag_name") for r in releases if isinstance(r, dict)] if isinstance(releases, list) else []
    return sorted((t for t in tags if isinstance(t, str) and TAG.fullmatch(t)), key=version_key, reverse=True)


def channel_tag(channel):
    if channel == "stable":
        return stable_tag()
    if channel != "rc":
        # omarchy-version-channel prints two words when they disagree.
        mirror, disagree, packages = channel.partition(" / ")
        problem = f"the channel is {channel}, and only stable and rc have tagged releases"
        if disagree:
            problem = f"the mirror says {mirror} and the packages say {packages}, so no one channel applies"
        raise NoRelease(f"{problem}. Pass a tag, such as omaupdateimpact v4.5.0.")
    tags = release_tags()
    if not tags:
        raise ValueError("the releases API gave no usable release")
    return tags[0]


def newer_releases(version):
    """The newest release past this version, and the newest stable one if that is an RC."""
    newer = [tag for tag in release_tags() if version_key(tag) > version_key(version)]
    stable = [tag for tag in newer if not is_prerelease(tag)]
    return list(dict.fromkeys(newer[:1] + stable[:1]))


def save(response, out, tag):
    """Write a download to out. On a terminal, count it: GitHub doesn't say the size up front."""
    if not sys.stderr.isatty():
        shutil.copyfileobj(response, out)
        return
    done = 0
    try:
        print(f"Downloading {tag}...", end="", file=sys.stderr, flush=True)
        for chunk in iter(lambda: response.read(1 << 20), b""):
            out.write(chunk)
            done += len(chunk)
            print(f"\rDownloading {tag}: {done / (1 << 20):.0f} MB", end="", file=sys.stderr, flush=True)
    finally:
        print(file=sys.stderr)


def prune(cache, tag, scratch):
    """Keep the release just fetched and the newest other. The rest move to scratch, which goes away.

    A rename is atomic, so a run cut short can't leave half a release that passes for a cached one.
    """
    releases = [path for path in cache.iterdir() if TAG.fullmatch(path.name)]
    releases.sort(key=lambda path: (path.name == tag, version_key(path.name)), reverse=True)
    for old in releases[KEPT_RELEASES:]:
        old.rename(scratch / old.name)


def fetch_release(tag, cache):
    root = cache / tag
    if not root.is_dir():
        cache.mkdir(parents=True, exist_ok=True)
        url = f"https://github.com/{REPO}/archive/refs/tags/{tag}.tar.gz"
        with tempfile.TemporaryDirectory(dir=cache) as scratch:
            archive = Path(scratch) / "release.tar.gz"
            with github(url, 120) as response, archive.open("wb") as out:
                save(response, out, tag)
            # tarfile stops at the end-of-archive marker and never reaches gzip's checksum.
            with gzip.open(archive) as stream:
                while stream.read(1 << 20):
                    pass
            with tarfile.open(archive) as tar:
                tar.extractall(scratch, filter="data")
            unpacked = next((p for p in Path(scratch).iterdir() if p.is_dir()), None)
            if unpacked is None:
                raise tarfile.ReadError("the archive holds no release")
            unpacked.rename(root)
            prune(cache, tag, Path(scratch))
    return root


def fetch_notes(tag, root):
    """Keep a release's notes in its folder. Without them findings give no reason, and nothing else changes.

    A tag with no release has no notes, and that is kept too, so it isn't asked again.
    """
    if (root / NOTES).exists():
        return
    try:
        try:
            release = api(f"releases/tags/{tag}")
        except urllib.error.HTTPError as error:
            if error.code != 404:
                raise
            release = {}
        body = release.get("body") if isinstance(release, dict) else None
        # GitHub gives null for a release without notes.
        if not isinstance(release, dict) or (body is not None and not isinstance(body, str)):
            raise ValueError("the releases API gave no usable notes")
        # Written whole and then moved, so notes cut short never pass for the notes.
        with tempfile.NamedTemporaryFile("w", dir=root, delete=False, encoding="utf-8", newline="") as out:
            out.write(body or "")
        os.replace(out.name, root / NOTES)
    except DOWNLOAD_ERRORS as error:
        print(f"Couldn't fetch the release notes, so no finding says why: {' '.join(str(error).split())}", file=sys.stderr)


def ask(command):
    """What an Omarchy command on PATH prints, or "unknown"."""
    try:
        output = subprocess.run([command], capture_output=True, text=True, check=True).stdout
    except (OSError, subprocess.CalledProcessError):
        return "unknown"
    return output.strip() or "unknown"


def installed_channel(version):
    # omarchy-version-channel reads the mirrors, and a linked checkout leaves those as they were.
    return "dev" if version.startswith("dev") else ask("omarchy-version-channel")


def described(target, channel):
    kind = {True: "prerelease", False: "not a prerelease", None: "can't tell if it's a prerelease"}
    return f"{target['name']} ({channel} channel, {kind[target['prerelease']]})"


def document(result, version, channel, name, **rest):
    """The --json document about a release. The text report is printed from it too."""
    return {
        "schemaVersion": SCHEMA_VERSION,
        "result": result,
        "installed": version,
        "channel": channel,
        "target": {"name": name, "prerelease": is_prerelease(name)},
        **rest,
    }


def no_update(version, tag, channel):
    """The release is already installed. Any newer one is on another channel."""
    try:
        newer = [{"tag": t, "channel": "rc" if is_prerelease(t) else "stable"} for t in newer_releases(version)]
    except DOWNLOAD_ERRORS as error:
        reason = f" {error}" if isinstance(error, (RateLimited, TokenRejected)) else ""
        problem = f"Couldn't check for newer releases on other channels.{reason}"
        return document("noUpdate", version, channel, tag, newer=None, newerProblem=problem)
    return document("noUpdate", version, channel, tag, newer=newer, newerProblem=None)


def check_states(findings):
    """Whether each check ran, ran in part or didn't run. Not running outranks running in part."""
    unknown = [finding for finding in findings if finding.level == UNKNOWN]
    not_run = {finding.check for finding in unknown if not finding.partial}
    in_part = {finding.check for finding in unknown if finding.partial}
    return {check: DIDNT_RUN if check in not_run else RAN_IN_PART if check in in_part else RAN for check in CHECKS}


def compared(version, channel, name, checked, findings):
    """The document for a comparison. A count that wasn't looked at is None, so it can't read as zero."""
    # A reviewed finding no longer counts.
    levels = {finding.level for finding in findings if not finding.reviewed}
    result = "attention" if ATTENTION in levels else "incomplete" if UNKNOWN in levels else "clear"
    states = check_states(findings)
    checks = {
        check: {"state": states[check], "checked": {count: checked.get(check, {}).get(count) for count in counts}}
        for check, counts in CHECKS.items()
    }
    return document(result, version, channel, name, checks=checks, findings=findings)


def counted(number, noun):
    return f"{number} {noun}{'' if number == 1 else 's'}"


def painted(text, colour):
    """Text in a colour on a terminal. NO_COLOR, unless it's empty, turns that off."""
    if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
        return text
    return f"\033[{colour}m{text}\033[0m"


def wrapped(text, first="", rest=""):
    """Fill text. A command is never split, and neither is a line to copy."""
    text = COPIED.sub(lambda found: found.group().replace(" ", KEPT_SPACE), text)
    filled = textwrap.fill(
        text, REPORT_WIDTH, initial_indent=first, subsequent_indent=rest, break_long_words=False, break_on_hyphens=False
    )
    return filled.replace(KEPT_SPACE, " ")


def checked_line(checks):
    """The "Checked" line. A count of None wasn't looked at, so it isn't listed."""
    bindings, packages, commands, plugins, edits = (checks[check]["checked"] for check in CHECKS)
    parts = [counted(bindings["defaults"], "default binding")]
    if bindings["yours"] is not None:
        parts.append(f"{bindings['yours']} of yours")
    removals, writes = packages["pendingMigrations"], edits["pendingMigrations"]
    # Both checks read the pending migrations, and each counts those it could read.
    if removals is not None and removals == writes:
        parts.append(counted(removals, "pending migration"))
    elif removals is not None and writes is not None:
        parts.append(f"{counted(removals, 'pending migration')} for packages and {writes} for file edits")
    elif removals is not None or writes is not None:
        what = "packages" if writes is None else "file edits"
        parts.append(f"{counted(removals if writes is None else writes, 'pending migration')} for {what}")
    if commands["deletedCommands"] == 0:
        parts.append("no deleted commands")
    elif commands["yourFiles"] is not None:
        deleted = counted(commands["deletedCommands"], "deleted command")
        parts.append(f"{commands['yourFiles']} of your files for {deleted}")
    if plugins["linted"] == 0:
        parts.append("no plugins")
    elif plugins["linted"] is not None:
        parts.append(f"{counted(plugins['linted'], 'plugin')} linted")
    return wrapped(f"Checked {', '.join(parts)}.")


def print_section(title, found, colour, hint=""):
    """A section of findings. One that can be reviewed shows its id."""
    if found:
        print(f"\n{painted(title, colour)}{hint}")
        for finding in found:
            text = f"{finding.text()} [{finding.id}]" if finding.level == ATTENTION else finding.text()
            print(wrapped(text, "  - ", "    "))
            if finding.reason:
                why = f"{finding.reason.text.rstrip('.')} ({finding.reason.reference})."
                print(wrapped(why, "    Why: ", " " * 9))
            if finding.fix:
                # Painted after filling, because colour codes would count as width.
                print(wrapped(finding.fix, "    Fix: ", " " * 9).replace("Fix:", painted("Fix:", GREEN), 1))


def print_closing(document):
    states = {check: value["state"] for check, value in document["checks"].items()}
    not_run = sorted(check for check, state in states.items() if state == DIDNT_RUN)
    in_part = sorted(check for check, state in states.items() if state == RAN_IN_PART)
    lines = []
    if not_run:
        lines.append(f"These checks didn't run: {', '.join(not_run)}.")
    if in_part:
        lines.append(f"These checks ran in part: {', '.join(in_part)}.")
    if lines:
        print(f"\n{painted(' '.join(lines), YELLOW)}")
    elif document["result"] == "clear" and any(finding.reviewed for finding in document["findings"]):
        print(f"\n{painted('Nothing else needs attention.', GREEN)}")
    elif document["result"] == "clear":
        print(f"\n{painted('Nothing found that needs attention.', GREEN)}")


def print_report(document, everything):
    findings = document["findings"]
    print(f"Omarchy {document['installed']} -> {described(document['target'], document['channel'])}. Nothing was changed.")
    print(checked_line(document["checks"]))
    attention = [finding for finding in findings if finding.level == ATTENTION and not finding.reviewed]
    print_section("Needs attention", attention, RED, ". Seen one, and it's fine? Run this again with --ack and its id.")
    notes = [finding for finding in findings if finding.level == NOTE]
    if everything:
        print_section("Worth knowing", notes, BOLD)
    elif notes:
        print(f"\n{painted('Worth knowing', BOLD)}: {counted(len(notes), 'note')}. Add --all to see them.")
    print_section("Limits of this check", [finding for finding in findings if finding.level == UNKNOWN], YELLOW)
    reviewed = [finding for finding in findings if finding.reviewed]
    if everything:
        print_section("Reviewed", reviewed, BOLD, f". These don't count for {document['target']['name']}.")
    elif reviewed:
        print(f"\n{painted('Reviewed', BOLD)}: {counted(len(reviewed), 'finding')}. Add --all to see them.")
    print_closing(document)


def print_no_update(document):
    already = described(document["target"], document["channel"])
    print(f"Omarchy {document['installed']} is already {already}. There is no update.")
    if document["newerProblem"]:
        print(document["newerProblem"])
    for release in document["newer"] or []:
        tag = release["tag"]
        print(f"Newer on the {release['channel']} channel: {tag}. To check it: omaupdateimpact {tag}")


def print_document(document, options):
    """Print a document as JSON, or as text. A failure has already said why on stderr."""
    if options.json:
        print(json.dumps(document, indent=2, default=Finding.data))
    elif document["result"] == "noUpdate":
        print_no_update(document)
    elif document["result"] != "failed":
        print_report(document, options.all)


def fail(what, error, debug):
    """Explain a failure on one line, with the traceback under --debug, and give its document."""
    if debug:
        traceback.print_exception(error)
    reason = f"{what}: {' '.join(str(error).split())}"
    print(reason, file=sys.stderr)
    return failure(reason)


def run(options):
    if options.tag and not TAG.fullmatch(options.tag):
        raise NoRelease(f"{options.tag} isn't a release tag. Tags look like v1.2.3 or v1.2.3-rc1.")
    options.home = options.home or Path.home()
    # omarchy-version only knows this machine, so it can't speak for a tree given by hand.
    own_tree = options.root is None
    options.root = options.root or Path(os.environ.get("OMARCHY_PATH") or INSTALLED)
    check_tree(options.root, "installed")
    version = ask("omarchy-version")
    channel = options.channel or installed_channel(version)
    target = options.target
    tag = options.tag
    if target is None:
        cache = Path(os.environ.get("XDG_CACHE_HOME") or options.home / ".cache") / "omaupdateimpact"
        try:
            tag = tag or channel_tag(channel)
            installed, wanted = version_key(version), version_key(tag)
            if own_tree and installed and installed == wanted:
                if options.ack:
                    raise NotReviewable("there is no update, so there is nothing to review.")
                return no_update(version, tag, channel)
            target = fetch_release(tag, cache)
            fetch_notes(tag, target)
        except DOWNLOAD_ERRORS as error:
            return fail("Couldn't download the release", error, options.debug)
    check_tree(target, "release")

    user, unreadable = read_user_bindings(options.home / ".config/hypr/bindings.lua", "~/.config/hypr/bindings.lua")
    current_defaults, target_defaults = parse_defaults(options.root, "installed"), parse_defaults(target, "release")

    # Only what was really looked at goes in here, so a check that didn't run isn't listed.
    checked = {"bindings": {"defaults": len(target_defaults.binds)}}
    if not unreadable:
        checked["bindings"]["yours"] = len(user.binds)
    findings = [
        *unreadable,
        *compare_bindings(current_defaults, target_defaults, user),
        *compare_packages(target, options.home, installed_packages(), checked),
        *compare_commands(options.root, target, options.home, checked),
        *compare_plugins(options.root, target, options.home, checked),
        *compare_edits(options.root, target, options.home, checked),
    ]
    give_reasons(findings, target)
    name = tag or target.name
    reviews = reviews_file(options.home)
    seen = read_reviews(reviews, name)
    if options.ack:
        seen |= record_reviews(reviews, name, findings, options.ack, seen)
    for finding in findings:
        finding.reviewed = finding.level == ATTENTION and finding.id in seen
    return compared(version, channel, name, checked, findings)


class Parser(argparse.ArgumentParser):
    """Bad usage gives a --json document too, when one was asked for."""

    def error(self, message):
        if wants_json(sys.argv[1:]):
            print(json.dumps(failure(f"Bad usage: {message}"), indent=2))
        super().error(message)


def main():
    parser = Parser(description="Check your Omarchy setup against a release.")
    parser.add_argument("tag", nargs="?", help="release tag (default: what your channel would deliver)")
    parser.add_argument("--version", action="version", version=f"omaupdateimpact {__version__}")
    parser.add_argument(
        "--channel",
        help="follow this channel: stable or rc; any other needs a tag (default: omarchy-version-channel)",
    )
    parser.add_argument("--target", type=Path, help="compare with this unpacked release instead of downloading one")
    parser.add_argument(
        "--root",
        type=Path,
        help="the installed tree (default: $OMARCHY_PATH, then /usr/share/omarchy)",
    )
    parser.add_argument("--home", type=Path, help="read your config from this folder (default: your home)")
    parser.add_argument("--all", action="store_true", help="show every note, not only how many there are")
    parser.add_argument(
        "--ack",
        action="append",
        metavar="ID",
        help="mark the finding with this id as reviewed, so it doesn't count for this release again",
    )
    parser.add_argument("--json", action="store_true", help="print one JSON document instead (see docs/json.md)")
    parser.add_argument("--debug", action="store_true", help="show the traceback when something fails")
    options = parser.parse_args()
    try:
        # Anything else printed goes to stderr, so stdout holds the document alone.
        with contextlib.redirect_stdout(sys.stderr) if options.json else contextlib.nullcontext():
            document = run(options)
        print_document(document, options)
        return RESULTS[document["result"]]
    except UnusableTree as error:
        document = fail("Can't compare", error, options.debug)
    except NoRelease as error:
        document = fail("Can't pick a release", error, options.debug)
    except NotReviewable as error:
        document = fail("Can't mark it reviewed", error, options.debug)
    except Exception as error:  # noqa: BLE001
        document = fail(f"Unexpected {type(error).__name__}", error, options.debug)
    print_document(document, options)
    return RESULTS["failed"]


if __name__ == "__main__":
    sys.exit(main())
