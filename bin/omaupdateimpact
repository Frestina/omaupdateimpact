#!/usr/bin/env python3
"""Check this machine's Omarchy setup against a release before updating.

Read-only: nothing from the release is ever run, its files are only read as
text. See README.md.
"""

import sys

# A breaking change to the --json document bumps this. See docs/json.md.
SCHEMA_VERSION = 1


def wants_json(argv):
    """Whether --json was asked for, read before argparse so bad usage can answer in JSON too.

    argparse takes an abbreviation, and --json is the only option starting --j.
    """
    for arg in argv:
        if arg == "--":
            return False
        if len(arg) > 2 and "--json".startswith(arg):
            return True
    return False


def failure(reason):
    """The --json document for a run that ends in exit 2."""
    return {"schemaVersion": SCHEMA_VERSION, "result": "failed", "reason": reason}


# Before the other imports, and this file must still parse on an old Python, or it
# gets a traceback instead. tarfile's filter= needs 3.11.4.
if sys.version_info < (3, 11, 4):
    found = ".".join(map(str, sys.version_info[:3]))
    reason = "omaupdateimpact needs Python 3.11.4 or newer, and this is " + found + "."
    print(reason, file=sys.stderr)
    if wants_json(sys.argv[1:]):
        import json

        print(json.dumps(failure(reason), indent=2))
    sys.exit(2)

