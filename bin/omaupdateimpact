#!/usr/bin/env python3
"""Check this machine's Omarchy setup against a release before updating.

Read-only: nothing from the release is ever run, its files are only read as
text. See README.md.
"""

import argparse
import gzip
import http.client
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import textwrap
import traceback
import urllib.error
import urllib.request
import zlib
from collections import Counter
from dataclasses import dataclass, field
from pathlib import Path

REPO = "omacom/omarchy"
INSTALLED = "/usr/share/omarchy"
TREE_PARTS = ["bin", "default/hypr", "migrations", "shell"]
MODIFIERS = ["SUPER", "CTRL", "SHIFT", "ALT", "CAPS", "MOD2", "MOD3", "MOD5"]
MODIFIER_SPELLINGS = {"CONTROL": "CTRL", "MOD1": "ALT", "WIN": "SUPER", "LOGO": "SUPER", "MOD4": "SUPER", "META": "SUPER"}
BIND_CALLS = ["o.bind_toggle", "o.bind_hold", "o.rebind", "o.bind", "hl.bind", "hl.unbind"]
# o.preinstalled_bindings_enabled only says whether a file's binds apply.
HELPERS_READ = {"o.bind_toggle", "o.bind_hold", "o.rebind", "o.bind", "o.preinstalled_bindings_enabled"}
HELPER = re.compile(r"(?<![\w.])(?:function\s+(o[.:][\w.:]*[Bb]ind\w*)|(o\.[\w.]*[Bb]ind\w*)\s*=\s*[A-Za-z_])")
LONG_STRING = re.compile(r"\[(=*)\[")
TEXT_SUFFIXES = {"", ".lua", ".sh", ".hook", ".conf", ".toml", ".json", ".qml", ".js", ".py"}
QMLLINT = "/usr/lib/qt6/bin/qmllint"
ATTENTION, NOTE, UNKNOWN = "attention", "note", "unknown"
DOWNLOAD_ERRORS = (OSError, EOFError, ValueError, zlib.error, tarfile.TarError, http.client.HTTPException)
VERSION = re.compile(r"(?:\d+:)?v?(\d+)\.(\d+)\.(\d+)(?:-?rc(\d+))?(?:-\d+)?")
TAG = re.compile(r"v\d+\.\d+\.\d+(?:-rc\d+)?", re.ASCII)
TOKEN = re.compile(r"[\x21-\x7e]+")
KEPT_RELEASES = 2


@dataclass
class Bind:
    description: str
    command: str
    source: str = ""
    keys: str = ""

    def same_action(self, other):
        if self.command == other.command:
            return True
        return bool(self.description) and self.description == other.description


@dataclass
class Computed:
    expression: str
    source: str


@dataclass
class Parsed:
    binds: dict = field(default_factory=dict)
    unbinds: dict = field(default_factory=dict)
    unread: list = field(default_factory=list)
    helpers: dict = field(default_factory=dict)


@dataclass
class Finding:
    check: str
    level: str
    title: str
    evidence: list
    detail: str = ""
    fix: str = ""

    def text(self):
        return " ".join(part for part in (self.title, self.detail, self.fix) if part)


class UnusableTree(Exception):
    """A tree that can't be compared: going on would report nothing to worry about."""


class RateLimited(OSError):
    """GitHub turned a request down because of its rate limit."""


class NoRelease(Exception):
    """A channel with no tagged release to follow."""


def blank_comments(text):
    """Remove Lua comments, leaving strings alone."""
    out, i = [], 0
    while i < len(text):
        if text[i : i + 2] == "--":
            end = long_string_end(text, i + 2) or text.find("\n", i)
            if end < 0:
                break
            i = end
            continue
        end = quoted_end(text, i) or i + 1
        out.append(text[i:end])
        i = end
    return "".join(out)


def string_end(text, start):
    i = start + 1
    while i < len(text) and text[i] != text[start]:
        i += 2 if text[i] == "\\" else 1
    return min(i + 1, len(text))


def long_string_end(text, start):
    """Where the long string opening at start ends, or None if none opens there."""
    opened = LONG_STRING.match(text, start)
    if not opened:
        return None
    end = text.find(f"]{opened.group(1)}]", opened.end())
    return len(text) if end < 0 else end + len(opened.group(0))


def quoted_end(text, start):
    """Where the string of either kind opening at start ends, or None if none opens there."""
    return string_end(text, start) if text[start] in "\"'" else long_string_end(text, start)


def call_arguments(text, start):
    """Split the arguments of the call whose opening bracket is at start."""
    args, depth, current, i = [], 0, [], start
    while i < len(text):
        char = text[i]
        end = quoted_end(text, i)
        if end is not None:
            current.append(text[i:end])
            i = end
            continue
        if char in "([{":
            depth += 1
            if depth > 1:
                current.append(char)
        elif char in ")]}":
            depth -= 1
            if depth == 0:
                args.append("".join(current).strip())
                return args
            current.append(char)
        elif char == "," and depth == 1:
            args.append("".join(current).strip())
            current = []
        else:
            current.append(char)
        i += 1
    return args


def literal(arg):
    """The value of a plain Lua string, or None for anything computed."""
    opened = LONG_STRING.match(arg)
    if opened and long_string_end(arg, 0) == len(arg) and arg.endswith(f"]{opened.group(1)}]"):
        # Lua drops a newline straight after the opening bracket.
        return arg[opened.end() : -len(opened.group(0))].removeprefix("\n")
    if len(arg) >= 2 and arg[0] in "\"'" and string_end(arg, 0) == len(arg):
        return arg[1:-1].replace('\\"', '"').replace("\\'", "'")
    return None


def tidy(expression):
    """A Lua expression with its spacing evened out, so a reformat doesn't read as a change."""
    out, code, i = [], [], 0

    def flush():
        spaced = " ".join("".join(code).split())
        out.append(re.sub(r" ?([^\w ]) ?", r"\1", spaced).replace(",}", "}"))
        code.clear()

    while i < len(expression):
        end = quoted_end(expression, i)
        if end is None:
            code.append(expression[i])
            i += 1
        else:
            flush()
            out.append(expression[i:end])
            i = end
    flush()
    return "".join(out)


def normalize_keys(keys):
    parts = [part.strip().upper() for part in keys.split("+") if part.strip()]
    parts = [MODIFIER_SPELLINGS.get(part, part) for part in parts]
    mods = [mod for mod in MODIFIERS if mod in parts]
    rest = [part for part in parts if part not in MODIFIERS]
    return " + ".join(mods + rest)


def spelling(keys):
    """What hl.unbind matches: the keys as written, whatever their spaces and case, and not the chord."""
    return keys.replace(" ", "").lower()


def command_text(arg):
    value = literal(arg)
    return tidy(arg) if value is None else value


def unbind(parsed, keys, source):
    if keys == "all":
        parsed.binds.clear()
        return
    chord = normalize_keys(keys)
    parsed.unbinds.setdefault(chord, {})[spelling(keys)] = source
    left = [bind for bind in parsed.binds.get(chord, []) if spelling(bind.keys) != spelling(keys)]
    if left:
        parsed.binds[chord] = left
    else:
        parsed.binds.pop(chord, None)


def parse_lua(text, parsed, source=""):
    """Collect the bind and unbind calls in one Lua file."""
    text = blank_comments(text)
    names = "|".join(re.escape(name) for name in BIND_CALLS)
    for match in re.finditer(rf"(?<![\w.])({names})\s*\(", text):
        name = match.group(1)
        args = call_arguments(text, match.end() - 1)
        keys = literal(args[0]) if args else None
        if keys is None:
            expression = tidy(args[0]) if args else ""
            # Turning a key off isn't the same call as binding it, whatever the expression.
            parsed.unread.append(Computed(f"hl.unbind({expression})" if name == "hl.unbind" else expression, source))
            continue
        if name in ("hl.unbind", "o.rebind"):
            unbind(parsed, keys, source)
        if name == "hl.unbind":
            continue
        args += [""] * (5 - len(args))
        if name == "hl.bind":
            found = re.search(r"description\s*=\s*([\"'])(.*?)\1", args[2])
            pairs = [(found.group(2) if found else "", args[1])]
        elif name == "o.bind_hold":
            pairs = [(literal(args[1]) or "", args[2]), (literal(args[3]) or "", args[4])]
        else:
            pairs = [(literal(args[1]) or "", args[2])]
        for description, command in pairs:
            command = command_text(command)
            if name == "o.bind_toggle":
                command = "omarchy-toggle-" + command
            parsed.binds.setdefault(normalize_keys(keys), []).append(Bind(description, command, source, keys))


def parse_helpers(text, parsed, source):
    """Note every binding helper the parser has no rule for."""
    for match in HELPER.finditer(blank_comments(text)):
        name = match.group(1) or match.group(2)
        if name not in HELPERS_READ:
            parsed.helpers[name] = source


def check_tree(root, name):
    missing = [part for part in TREE_PARTS if not (root / part).is_dir() or not any((root / part).iterdir())]
    if missing:
        raise UnusableTree(f"the {name} tree {root} has nothing in {', '.join(missing)}.")


def parse_defaults(root, name):
    parsed = Parsed()
    for path in sorted((root / "default/hypr").rglob("*.lua")):
        text, source = path.read_text(errors="replace"), str(path.relative_to(root))
        parse_helpers(text, parsed, source)
        if path.name != "helpers.lua":
            parse_lua(text, parsed, source)
    if not parsed.binds:
        raise UnusableTree(f"the {name} tree {root} has no readable default bindings, so the format has moved.")
    return parsed


def read_user_bindings(path, shown):
    """The user's bindings, and a finding if the file is there but can't be read."""
    parsed = Parsed()
    try:
        path.lstat()
    except FileNotFoundError:
        # A dotfiles folder on an unmounted drive looks just like having no bindings.
        broken = any(parent.is_symlink() and not parent.exists() for parent in path.parents)
        return parsed, [unreadable_bindings(shown, "It's a broken link")] if broken else []
    except NotADirectoryError:
        return parsed, []
    except OSError as error:
        return parsed, [unreadable_bindings(shown, error.strerror)]
    # Reading a FIFO would hang, so anything but a file stops here.
    if not path.is_file():
        reason = "It's a broken link" if path.is_symlink() and not path.exists() else "It isn't a file"
        return parsed, [unreadable_bindings(shown, reason)]
    try:
        parse_lua(path.read_text(errors="replace"), parsed, shown)
    except OSError as error:
        return Parsed(), [unreadable_bindings(shown, error.strerror)]
    return parsed, []


def unreadable_bindings(shown, reason):
    return Finding(
        "bindings", UNKNOWN, f"{shown} couldn't be read, so your bindings weren't compared.", [shown], detail=f"{reason}."
    )


def label(binds):
    return " / ".join(dict.fromkeys(bind.description or bind.command for bind in binds))


def sources(*groups):
    return sorted({bind.source for binds in groups for bind in binds})


def spelled(binds):
    """The keys of these binds as written, once for each way of writing them."""
    return list({spelling(bind.keys): bind.keys for bind in binds}.values())


def same_actions(one, other):
    """Whether two chords do the same. A press alone isn't the same as a press and release pair."""
    return all(any(a.same_action(b) for b in other) for a in one) and all(
        any(b.same_action(a) for a in one) for b in other
    )


def compare_computed(current, target, user):
    before = Counter(computed.expression for computed in current.unread)
    after = Counter(computed.expression for computed in target.unread)
    findings = []
    for expression in sorted(set(before) | set(after)):
        if before[expression] != after[expression]:
            evidence = {c.source for c in current.unread + target.unread if c.expression == expression}
            findings.append(Finding(
                "bindings",
                UNKNOWN,
                f"The computed key {expression} isn't the same in both versions, so it wasn't compared.",
                sorted(evidence),
                detail="It could land on one of your keys.",
            ))
    for expression in sorted({computed.expression for computed in user.unread}):
        findings.append(Finding(
            "bindings",
            UNKNOWN,
            f"Your computed key {expression} wasn't compared.",
            sorted({c.source for c in user.unread if c.expression == expression}),
            detail="It could clash with a default.",
        ))
    same = before & after
    if same:
        evidence = {c.source for c in current.unread + target.unread if c.expression in same}
        findings.append(Finding(
            "bindings",
            NOTE,
            f"{same.total()} key bindings use computed keys and weren't compared.",
            sorted(evidence),
        ))
    return findings


def compare_bindings(current, target, user):
    cur, tgt = current.binds, target.binds
    changed = {c for c in cur if c not in tgt or not same_actions(cur[c], tgt[c])}
    arrived = {c for c in tgt if c not in cur or not same_actions(cur[c], tgt[c])}
    findings = []

    def turned_off(chord, binds):
        return all(spelling(bind.keys) in user.unbinds.get(chord, {}) for bind in binds)

    moved = {}
    for chord in sorted(changed):
        for other in sorted(arrived - {chord}):
            if same_actions(cur[chord], tgt[other]):
                moved[chord] = other
                break

    for chord in sorted(user.binds):
        mine = user.binds[chord]
        if chord not in arrived or turned_off(chord, tgt[chord]):
            continue
        calls = " and ".join(f'hl.unbind("{keys}")' for keys in spelled(tgt[chord]))
        findings.append(Finding(
            "bindings",
            ATTENTION,
            f'{chord}: your "{label(mine)}" will clash with the new default "{label(tgt[chord])}".',
            sources(mine, tgt[chord]),
            detail="Both will fire.",
            fix=f"Add {calls} or choose another key.",
        ))

    for chord in sorted(user.unbinds):
        if chord not in cur or not turned_off(chord, cur[chord]):
            continue
        unbound = sorted(set(user.unbinds[chord].values()))
        if chord in moved:
            if not turned_off(moved[chord], tgt[moved[chord]]):
                findings.append(Finding(
                    "bindings",
                    ATTENTION,
                    f'{chord}: you turned off "{label(cur[chord])}" here, but it moves to '
                    f"{moved[chord]}, so it comes back.",
                    [*unbound, *sources(cur[chord], tgt[moved[chord]])],
                    fix=f"Unbind {' and '.join(spelled(tgt[moved[chord]]))} too.",
                ))
        elif chord not in tgt:
            findings.append(Finding(
                "bindings",
                NOTE,
                f"{chord}: your unbind no longer does anything, the default is gone.",
                [*unbound, *sources(cur[chord])],
            ))
        elif chord in arrived and chord in user.binds and turned_off(chord, tgt[chord]):
            findings.append(Finding(
                "bindings",
                NOTE,
                f'{chord}: your binding now replaces "{label(tgt[chord])}", '
                f'not "{label(cur[chord])}".',
                sources(user.binds[chord], tgt[chord]),
            ))

    for chord, other in sorted(moved.items()):
        findings.append(Finding(
            "bindings",
            NOTE,
            f'Moved: "{label(cur[chord])}" from {chord} to {other}.',
            sources(cur[chord], tgt[other]),
        ))

    for chord in sorted(c for c in arrived if c in cur and c not in user.binds):
        findings.append(Finding(
            "bindings",
            NOTE,
            f'{chord} is now "{label(tgt[chord])}", it was "{label(cur[chord])}".',
            sources(cur[chord], tgt[chord]),
        ))

    fresh = sorted(
        c for c in arrived
        if c not in cur and c not in moved.values() and c not in user.binds and not c.startswith("SWITCH:")
    )
    if fresh:
        lines = ", ".join(f'{c} ("{label(tgt[c])}")' for c in fresh)
        findings.append(Finding(
            "bindings", NOTE, f"New default shortcuts: {lines}.", sources(*(tgt[c] for c in fresh))
        ))

    gone = sorted(c for c in changed if c not in moved and c not in tgt and not turned_off(c, cur[c]))
    if gone:
        lines = ", ".join(f'{c} ("{label(cur[c])}")' for c in gone)
        findings.append(Finding(
            "bindings", NOTE, f"Default shortcuts removed: {lines}.", sources(*(cur[c] for c in gone))
        ))

    for name, source in sorted({**current.helpers, **target.helpers}.items()):
        findings.append(Finding(
            "bindings",
            UNKNOWN,
            f"The binding helper {name} isn't one this tool can read, so keys bound with it weren't compared.",
            [source],
        ))

    return [*findings, *compare_computed(current, target, user)]


def installed_packages():
    try:
        output = subprocess.run(["pacman", "-Qq"], capture_output=True, text=True, check=True).stdout
    except (OSError, subprocess.CalledProcessError):
        return None
    return set(output.split())


def package_changes(migrations, already_run):
    """Packages the pending migrations remove: whether that is conditional, and which migration."""
    dropped = {}
    for path in sorted(migrations.glob("*.sh")):
        if path.name in already_run:
            continue
        for line in path.read_text(errors="replace").splitlines():
            found = re.match(r"(\s*)omarchy-pkg-(drop|remove|add)\s+([^|;&>#]*)", line)
            if not found:
                continue
            packages = [p for p in found.group(3).split() if re.fullmatch(r"[\w@.+-]+", p)]
            for package in packages:
                if found.group(2) == "add":
                    dropped.pop(package, None)
                else:
                    dropped[package] = (bool(found.group(1)), path.name)
    return dropped


def compare_packages(target, home, installed):
    if installed is None:
        title = "pacman wasn't available, so packages weren't checked."
        return [Finding("packages", UNKNOWN, title, ["pacman -Qq"])]
    state = home / ".local/state/omarchy/migrations"
    already_run = {p.name for p in state.iterdir()} if state.is_dir() else set()
    dropped = package_changes(target / "migrations", already_run)
    findings = []
    for package in sorted(set(dropped) & installed):
        conditional, migration = dropped[package]
        when = "may remove" if conditional else "will remove"
        findings.append(Finding(
            "packages",
            ATTENTION,
            f"The update {when} {package}, which is installed here.",
            [f"migrations/{migration}"],
        ))
    return findings


def user_files(home):
    roots = [
        home / ".config/hypr",
        home / ".config/omarchy/hooks",
        home / ".config/omarchy/extensions",
        home / ".config/omarchy/plugins",
    ]
    singles = [home / ".bashrc", home / ".bashrc.local", home / ".config/omarchy/shell.toml"]
    for root in roots:
        if root.is_dir():
            for directory, subdirs, names in os.walk(root, followlinks=True):
                subdirs[:] = [d for d in subdirs if d != ".git"]
                for name in names:
                    path = Path(directory) / name
                    if path.suffix in TEXT_SUFFIXES and ".bak" not in name:
                        yield path
    yield from (path for path in singles if path.is_file())


def compare_commands(current, target, home):
    removed = {p.name for p in (current / "bin").glob("omarchy-*")}
    removed -= {p.name for p in (target / "bin").glob("omarchy-*")}
    if not removed:
        return []
    pattern = re.compile(r"(?<![\w-])(" + "|".join(map(re.escape, sorted(removed))) + r")(?![\w-])")
    found = set()
    for path in user_files(home):
        try:
            lines = path.read_text(errors="strict").splitlines()
        except (OSError, UnicodeDecodeError):
            continue
        comments = ("--",) if path.suffix == ".lua" else ("#", "//")
        for line in lines:
            if line.lstrip().startswith(comments):
                continue
            for command in pattern.findall(line):
                found.add((command, path))
    findings = []
    for command, path in sorted(found, key=lambda item: (str(item[1]), item[0])):
        shown = str(path).replace(str(home), "~", 1)
        findings.append(Finding(
            "commands", ATTENTION, f"{shown} calls {command}, which the release deletes.", [shown]
        ))
    return findings


def lint(plugin, shell, qmllint):
    """Count qmllint warnings for a plugin, ignoring line numbers."""
    files = sorted(str(p) for p in plugin.rglob("*.qml") if ".git" not in p.parts)
    if not files:
        return Counter()
    with tempfile.TemporaryDirectory() as imports:
        (Path(imports) / "qs").symlink_to(shell)
        result = subprocess.run(
            [qmllint, "-I", imports, *files], capture_output=True, text=True, cwd=plugin
        )
    warnings = Counter()
    for line in (result.stdout + result.stderr).splitlines():
        found = re.match(r"(Warning|Error): (.+?):\d+:\d+: (.*)", line)
        if found:
            warnings[(Path(found.group(2)).name, found.group(3))] += 1
    return warnings


def compare_plugins(current, target, home):
    plugins = home / ".config/omarchy/plugins"
    installed = sorted(p for p in plugins.iterdir() if p.is_dir()) if plugins.is_dir() else []
    if not installed:
        return []
    shown = "~/.config/omarchy/plugins"
    qmllint = shutil.which("qmllint") or (QMLLINT if Path(QMLLINT).exists() else None)
    if not qmllint:
        return [Finding("plugins", UNKNOWN, "qmllint wasn't found, so plugins weren't linted.", [shown])]
    findings = []
    for plugin in installed:
        before = lint(plugin.resolve(), current / "shell", qmllint)
        after = lint(plugin.resolve(), target / "shell", qmllint)
        new = after - before
        if new:
            sample = next(iter(new))
            findings.append(Finding(
                "plugins",
                NOTE,
                f"{plugin.name}: {sum(new.values())} new qmllint warnings, such as "
                f"{sample[0]}: {sample[1]}",
                [f"{shown}/{plugin.name}/{sample[0]}"],
            ))
    findings.append(Finding(
        "plugins",
        NOTE,
        "qmllint can't prove a plugin works. Most plugin breaks only show when the shell runs them.",
        [shown],
    ))
    return findings


def version_key(text):
    """A sort key for a tag or a package version, or None for anything else.

    The tag v4.5.0-rc2 is the package 4.5.0rc2-1, and a pkgrel is the same release.
    """
    found = VERSION.fullmatch(text)
    if not found:
        return None
    major, minor, patch, rc = found.groups()
    return int(major), int(minor), int(patch), float("inf") if rc is None else int(rc)


def is_prerelease(name):
    key = version_key(name)
    return None if key is None else key[3] != float("inf")


def github(url, timeout, token=None, advice="Try again later."):
    request = urllib.request.Request(url)
    if token:
        # urllib carries plain headers along a redirect, whatever host it leads to.
        request.add_unredirected_header("Authorization", f"Bearer {token}")
    try:
        return urllib.request.urlopen(request, timeout=timeout)
    except urllib.error.HTTPError as error:
        with error:
            limited = error.headers.get("x-ratelimit-remaining") == "0" or "retry-after" in error.headers
            if error.code in (403, 429) and limited:
                raise RateLimited(f"GitHub's rate limit is used up. {advice}") from error
            raise


def api(path):
    token = os.environ.get("GITHUB_TOKEN", "").strip()
    if token and not TOKEN.fullmatch(token):
        # http.client's own complaint would quote the value.
        raise ValueError("GITHUB_TOKEN holds characters a request header can't carry")
    advice = "Try again later." if token else "Try again later, or set GITHUB_TOKEN."
    with github(f"https://api.github.com/repos/{REPO}/{path}", 30, token, advice) as response:
        return json.load(response)


def stable_tag():
    release = api("releases/latest")
    tag = release.get("tag_name") if isinstance(release, dict) else None
    if not isinstance(tag, str) or not TAG.fullmatch(tag):
        raise ValueError("the releases API gave no usable release")
    return tag


def release_tags():
    """Every release tag, newest version first. The API sorts by date, so a stable patch can top an RC."""
    releases = api("releases?per_page=100")
    tags = [r.get("tag_name") for r in releases if isinstance(r, dict)] if isinstance(releases, list) else []
    return sorted((t for t in tags if isinstance(t, str) and TAG.fullmatch(t)), key=version_key, reverse=True)


def channel_tag(channel):
    if channel == "stable":
        return stable_tag()
    if channel != "rc":
        raise NoRelease(
            f"the channel is {channel}, and only stable and rc have tagged releases. "
            "Pass a tag, such as omaupdateimpact v4.5.0."
        )
    tags = release_tags()
    if not tags:
        raise ValueError("the releases API gave no usable release")
    return tags[0]


def newer_releases(version):
    """The newest release past this version, and the newest stable one if that is an RC."""
    newer = [tag for tag in release_tags() if version_key(tag) > version_key(version)]
    stable = [tag for tag in newer if not is_prerelease(tag)]
    return list(dict.fromkeys(newer[:1] + stable[:1]))


def save(response, out, tag):
    """Write a download to out. On a terminal, count it: GitHub doesn't say the size up front."""
    if not sys.stderr.isatty():
        shutil.copyfileobj(response, out)
        return
    done = 0
    try:
        print(f"Downloading {tag}...", end="", file=sys.stderr, flush=True)
        while chunk := response.read(1 << 20):
            out.write(chunk)
            done += len(chunk)
            print(f"\rDownloading {tag}: {done / (1 << 20):.0f} MB", end="", file=sys.stderr, flush=True)
    finally:
        print(file=sys.stderr)


def prune(cache, tag, scratch):
    """Keep the release just fetched and the newest other. The rest move to scratch, which goes away.

    A rename is atomic, so a run cut short can't leave half a release that passes for a cached one.
    """
    releases = [path for path in cache.iterdir() if TAG.fullmatch(path.name)]
    releases.sort(key=lambda path: (path.name == tag, version_key(path.name)), reverse=True)
    for old in releases[KEPT_RELEASES:]:
        old.rename(scratch / old.name)


def fetch_release(tag, cache):
    root = cache / tag
    if not root.is_dir():
        cache.mkdir(parents=True, exist_ok=True)
        url = f"https://github.com/{REPO}/archive/refs/tags/{tag}.tar.gz"
        with tempfile.TemporaryDirectory(dir=cache) as scratch:
            archive = Path(scratch) / "release.tar.gz"
            with github(url, 120) as response, archive.open("wb") as out:
                save(response, out, tag)
            # tarfile stops at the end-of-archive marker and never reaches gzip's checksum.
            with gzip.open(archive) as stream:
                while stream.read(1 << 20):
                    pass
            with tarfile.open(archive) as tar:
                tar.extractall(scratch, filter="data")
            unpacked = next((p for p in Path(scratch).iterdir() if p.is_dir()), None)
            if unpacked is None:
                raise tarfile.ReadError("the archive holds no release")
            unpacked.rename(root)
            prune(cache, tag, Path(scratch))
    return root


def ask(command):
    """What an Omarchy command on PATH prints, or "unknown"."""
    try:
        output = subprocess.run([command], capture_output=True, text=True, check=True).stdout
    except (OSError, subprocess.CalledProcessError):
        return "unknown"
    return output.strip() or "unknown"


def installed_channel(version):
    # omarchy-version-channel reads the mirrors, and a linked checkout leaves those as they were.
    return "dev" if version.startswith("dev") else ask("omarchy-version-channel")


def described(name, channel):
    kind = {True: "prerelease", False: "not a prerelease", None: "can't tell if it's a prerelease"}
    return f"{name} ({channel} channel, {kind[is_prerelease(name)]})"


def report_no_update(version, tag, channel):
    print(f"Omarchy {version} is already {described(tag, channel)}. There is no update.")
    try:
        newer = newer_releases(version)
    except DOWNLOAD_ERRORS as error:
        reason = f" {error}" if isinstance(error, RateLimited) else ""
        print(f"Couldn't check for newer releases on other channels.{reason}")
        return 0
    for release in newer:
        name = "rc" if is_prerelease(release) else "stable"
        print(f"Newer on the {name} channel: {release}. To check it: omaupdateimpact {release}")
    return 0


def print_section(title, findings, level):
    lines = [finding.text() for finding in findings if finding.level == level]
    if lines:
        print(f"\n{title}")
        for line in lines:
            print(textwrap.fill(line, 88, initial_indent="  - ", subsequent_indent="    "))


def fail(what, error, debug):
    """Explain a failure on one line, with the traceback under --debug, and exit 2."""
    if debug:
        traceback.print_exception(error)
    print(f"{what}: {' '.join(str(error).split())}", file=sys.stderr)
    return 2


def run(options):
    if options.tag and not TAG.fullmatch(options.tag):
        raise NoRelease(f"{options.tag} isn't a release tag. Tags look like v1.2.3 or v1.2.3-rc1.")
    options.home = options.home or Path.home()
    # omarchy-version only knows this machine, so it can't speak for a tree given by hand.
    own_tree = options.root is None
    options.root = options.root or Path(os.environ.get("OMARCHY_PATH") or INSTALLED)
    check_tree(options.root, "installed")
    version = ask("omarchy-version")
    channel = options.channel or installed_channel(version)
    target = options.target
    tag = options.tag
    if target is None:
        cache = Path(os.environ.get("XDG_CACHE_HOME") or options.home / ".cache") / "omaupdateimpact"
        try:
            tag = tag or channel_tag(channel)
            installed, wanted = version_key(version), version_key(tag)
            if own_tree and installed and installed == wanted:
                return report_no_update(version, tag, channel)
            target = fetch_release(tag, cache)
        except DOWNLOAD_ERRORS as error:
            return fail("Couldn't download the release", error, options.debug)
    check_tree(target, "release")

    user, unreadable = read_user_bindings(options.home / ".config/hypr/bindings.lua", "~/.config/hypr/bindings.lua")

    findings = [
        *unreadable,
        *compare_bindings(parse_defaults(options.root, "installed"), parse_defaults(target, "release"), user),
        *compare_packages(target, options.home, installed_packages()),
        *compare_commands(options.root, target, options.home),
        *compare_plugins(options.root, target, options.home),
    ]

    print(f"Omarchy {version} -> {described(tag or target.name, channel)}. Nothing was changed.")
    print_section("Needs attention", findings, ATTENTION)
    print_section("Worth knowing", findings, NOTE)
    print_section("Limits of this check", findings, UNKNOWN)
    levels = {finding.level for finding in findings}
    not_run = sorted({finding.check for finding in findings if finding.level == UNKNOWN})
    if not_run:
        print(f"\nThese checks didn't run: {', '.join(not_run)}.")
    elif ATTENTION not in levels:
        print("\nNothing found that needs attention.")
    return 1 if ATTENTION in levels else 3 if UNKNOWN in levels else 0


def main():
    parser = argparse.ArgumentParser(description="Check your Omarchy setup against a release.")
    parser.add_argument("tag", nargs="?", help="release tag (default: what your channel would deliver)")
    parser.add_argument("--channel", help="follow this channel (default: omarchy-version-channel)")
    parser.add_argument("--target", type=Path, help="use an unpacked release instead of downloading")
    parser.add_argument(
        "--root",
        type=Path,
        help="the installed tree (default: $OMARCHY_PATH, then /usr/share/omarchy)",
    )
    parser.add_argument("--home", type=Path)
    parser.add_argument("--debug", action="store_true", help="show the traceback when something fails")
    options = parser.parse_args()
    try:
        return run(options)
    except UnusableTree as error:
        return fail("Can't compare", error, options.debug)
    except NoRelease as error:
        return fail("Can't pick a release", error, options.debug)
    except Exception as error:
        return fail(f"Unexpected {type(error).__name__}", error, options.debug)


if __name__ == "__main__":
    sys.exit(main())
